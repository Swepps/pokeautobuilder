@using PokemonDataModel
@using Utility

@inject TypeChart TypeChart

@if (Pokemon is not null)
{
	<div class="d-flex flex-column align-center justify-center">
		<MudStack Spacing="5" AlignItems="AlignItems.Center" Style="width: 100%;" Class="pa-2">
			<MudText Typo="Typo.subtitle1" Class="mb-2">Type Defense</MudText>
			<MudStack Row="true" Style="width: 100%;" AlignItems="AlignItems.Center" Spacing="0">
				<MudText Typo="Typo.caption" Class="mr-1" Style="width: 50px">Resist</MudText>
				<div class="d-flex flex-wrap justify-start align-content-start">
					@foreach (string t in _activeRuleset.EnabledTypes)
					{
						@if (Pokemon.GetResistance(t, _activeRuleset.Id) < 1.0)
						{
							<MudStack Spacing="0" Class="d-flex flex-column align-center justify-center ma-1">
								<MudTooltip Text="@StringUtils.PrettifyString(t)">
									<MudImage Src="@StringUtils.TypeImgFromName(t)" Alt="@t" Height="20" Class="ma-1" />
								</MudTooltip>
								@if (Pokemon.GetResistance(t, _activeRuleset.Id) == 0.5)
								{
									<MudText Typo="Typo.caption">½x</MudText>
								}
								else if (Pokemon.GetResistance(t, _activeRuleset.Id) == 0.25)
								{
									<MudText Typo="Typo.caption" Style="font-weight: bold;">¼x</MudText>
								}
								else
								{
									<MudText Typo="Typo.caption" Style="font-weight: bold;">Imm</MudText>
								}
							</MudStack>
						}
					}
				</div>
			</MudStack>
			<MudDivider />
			<MudStack Row="true" Style="width: 100%;" AlignItems="AlignItems.Center" Spacing="0">
				<MudText Typo="Typo.caption" Class="mr-1" Style="width: 50px">Weak</MudText>
				<div class="d-flex flex-wrap justify-start align-content-start">
					@foreach (string t in _activeRuleset.EnabledTypes)
					{
						@if (Pokemon.GetResistance(t, _activeRuleset.Id) > 1.0)
						{
							<MudStack Spacing="0" Class="d-flex flex-column align-center justify-center ma-1">
								<MudTooltip Text="@StringUtils.PrettifyString(t)">
									<MudImage Src="@StringUtils.TypeImgFromName(t)" Alt="@t" Height="20" Class="ma-1" />
								</MudTooltip>
								@if (Pokemon.GetResistance(t, _activeRuleset.Id) <= 2.0)
								{
									<MudText Typo="Typo.caption">@(Pokemon.GetResistance(t, _activeRuleset.Id))x</MudText>
								}
								else
								{
									<MudText Typo="Typo.caption" Style="font-weight: bold;">@(Pokemon.GetResistance(t, _activeRuleset.Id))x</MudText>
								}
							</MudStack>
						}
					}
				</div>
			</MudStack>
		</MudStack>
	</div>
}

@code {
	[Parameter]
	public SmartPokemon? Pokemon { get; set; }

	[CascadingParameter]
	public BoxRules? ActiveRuleset { get; set; }

	private BoxRules _activeRuleset => ActiveRuleset ?? BoxRules.Unrestricted();

	protected override void OnParametersSet()
	{
		if (Pokemon is not null && !Pokemon.HasInitializedRuleset(_activeRuleset.Id))
			Pokemon.InitializeTypes(TypeChart.GetOrBuildDerived(_activeRuleset.Id, _activeRuleset.DisabledTypes), _activeRuleset.Id);
	}
}
