@using Autobuilder
@using PokeAutobuilder.Shared.Cards
@using PokeAutobuilder.Source.Services
@using PokemonDataModel
@using Utility

@inject SessionService Session
@inject ProfileService Profile
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@implements IDisposable

@page "/autobuilder"

<MudStack AlignItems="AlignItems.Start">

    <MudGrid>
        <MudItem xs="12" md="6">

            <MudExpansionPanels>
                <MudExpansionPanel Text="Box Settings" Expanded="true">

                    <MudSelect T="PokemonBox" Label="Select a box to generate a team from" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                               @bind-Value="SelectedBox" Disabled="Generating" FullWidth="true">
                        @foreach (PokemonBox box in Profile.PokemonStorage.Boxes)
                        {
                            <MudSelectItem T="PokemonBox" Value="box">
                                @box.Name
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <CascadingValue Value="@_lockedPokemon">
                        <PokemonStorageBox PokemonCollection="@(SelectedBox is not null ? SelectedBox.Pokemon : new())" OnClickPokemon="OnClickPokemon" />
                    </CascadingValue>

                </MudExpansionPanel>
            </MudExpansionPanels>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudExpansionPanels>
                <MudExpansionPanel Text="Generation Settings" Expanded="true">

                    <MudStack Style="max-width: 520px;">
                        <MudSlider Disabled="Generating" Min="3" Max="6" Step="1" @bind-Value="@TeamSize" Variant="Variant.Filled" TickMarks="true">Team Size</MudSlider>
                        <MudNumericField Disabled="Generating" @bind-Value="NumGenerations" Label="Generations" Variant="Variant.Text" Min="10" Max="200" Step="10" />
                        <MudNumericField Disabled="Generating" @bind-Value="PopulationSize" Label="Population Size" Variant="Variant.Text" Min="50" Max="1000" Step="50" />
                    </MudStack>

                </MudExpansionPanel>

                <MudExpansionPanel Text="Generation Parameters" Expanded="false">

                    <MudText Typo="Typo.subtitle1">Types</MudText>
                    <MudText Typo="Typo.caption">Click a type to toggle it. Disabled types won't be considered during team generation</MudText>

                    <div class="mt-1 mb-1">
                        @foreach (string t in Globals.AllTypes)
                        {
                            <MudButton OnClick="() => OnClickType(t)" Style="height: 48px; min-width: 48px" Class="pa-0" Disabled="Generating">
                                <MudTooltip Text="@StringUtils.PrettifyString(t)" RootClass="d-flex">
                                    @if (Generating)
                                    {
                                        <MudImage Src="@StringUtils.DisabledTypeImgFromName(t)" alt="@t" Height="30" Class="ma-1" />
                                    }
                                    else if (GenerationParameters.Types.ContainsKey(t) && GenerationParameters.Types[t])
                                    {
                                        <MudImage Src="@StringUtils.TypeImgFromName(t)" alt="@t" Height="30" Class="ma-1"/>
                                    }
                                    else
                                    {
                                        <MudImage Src="@StringUtils.DisabledTypeImgFromName(t)" alt="@t" Height="30" Class="ma-1" />
                                    }
                                </MudTooltip>
                            </MudButton>
                        }
                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Attack</MudText>

                    <div class="px-4 mt-1" style="max-width: 560px;">
                        <MudText Typo="Typo.subtitle2">STAB Coverage</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of STAB coverage</MudText>
                        <WeightingSlider Name="All Types"
                                         InlineLabel="true"
                                            Tooltip="Importance of a team with at least one Pokémon with STAB coverage against each type"
                                            @bind-Value="GenerationParameters.StabAll"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                            Tooltip="Importance of a balanced amount of STAB coverage."
                                            @bind-Value="GenerationParameters.StabBalance"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                            Tooltip="Importance of a higher amount of STAB coverage."
                                            @bind-Value="GenerationParameters.StabAmount"
                                            Disabled="Generating" />

                        <MudDivider Class="mb-2" DividerType="DividerType.Inset" />

                        <MudText Typo="Typo.subtitle2">Move Coverage</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of move coverage</MudText>
                        <WeightingSlider Name="All Types"
                                         InlineLabel="true"
                                            Tooltip="Importance of a team with at least one Pokémon with move coverage against each type"
                                            @bind-Value="GenerationParameters.MoveSetAll"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                            Tooltip="Importance of a balanced amount of move coverage"
                                            @bind-Value="GenerationParameters.MoveSetBalance"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                            Tooltip="Importance of a higher amount of move coverage"
                                            @bind-Value="GenerationParameters.MoveSetAmount"
                                            Disabled="Generating" />

                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Defense</MudText>

                    <div class="px-4" style="max-width: 560px;">
                        <MudText Typo="Typo.subtitle2">Resistances</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of type resistances</MudText>

                        <WeightingSlider Name="All Types"
                                         InlineLabel="true"
                                         Tooltip="Importance of a team with at least one Pokémon resistant to each type"
                                         @bind-Value="GenerationParameters.ResistanceAll"
                                         Disabled="Generating" />

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                         Tooltip="Importance of a balanced number of type resistances"
                                         @bind-Value="GenerationParameters.ResistanceBalance"
                                         Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                         Tooltip="Importance of a higher amount of type resistances"
                                         @bind-Value="GenerationParameters.ResistanceAmount"
                                         Disabled="Generating" />

                        <MudDivider Class="mb-2" DividerType="DividerType.Inset" />

                        <MudText Typo="Typo.subtitle2">Weaknesses</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of type weaknesses</MudText>

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                            Tooltip="Importance of a balanced number of type weaknesses"
                                            @bind-Value="GenerationParameters.WeaknessBalance"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                            Tooltip="Importance of a lower amount of type weaknesses"
                                            @bind-Value="GenerationParameters.WeaknessAmount"
                                            Disabled="Generating" />

                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Miscellaneous</MudText>
                    <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of other misc. attributes</MudText>

                    <div class="px-4" style="max-width: 560px;">
                        <WeightingSlider Name="Good Coverage On Offensive Pokémon"
                                            Tooltip="Importance of good coverage on offensive Pokémon - e.g. a Pokémon with good offensive stats should have STAB coverage against more types"
                                            @bind-Value="GenerationParameters.CoverageOnOffensive"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Good Resistances On Defensive Pokémon"
                                            Tooltip="Importance of good resistances on defensive Pokémon - e.g. a Pokémon with good defensive stats should also be resistant to more types"
                                            @bind-Value="GenerationParameters.ResistancesOnDefensive"
                                            Disabled="Generating" />
                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Stat Weightings</MudText>
                    <MudText Typo="Typo.caption">Use the sliders to adjust the importance of base statistics</MudText>

                    <div class="px-4" style="max-width: 560px;">
                        <WeightingSlider Name="Base Stats"
                                         Size="Size.Medium"
                                         Tooltip="The overall importance of base stats"
                                         @bind-Value="GenerationParameters.BaseStatTotal"
                                         Disabled="Generating" />

                        <WeightingSlider Name="HP"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the HP base stat"
                                         @bind-Value="GenerationParameters.BaseStatHp"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Attack"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Attack base stat"
                                         @bind-Value="GenerationParameters.BaseStatAtt"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Sp. Attack"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Special Attack base stat"
                                         @bind-Value="GenerationParameters.BaseStatSpAtt"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Defense"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Defense base stat"
                                         @bind-Value="GenerationParameters.BaseStatDef"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Sp. Defense"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Special Defense base stat"
                                         @bind-Value="GenerationParameters.BaseStatSpDef"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Speed"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Speed base stat"
                                         @bind-Value="GenerationParameters.BaseStatSpe"
                                         Disabled="Generating" />

                    </div>

                </MudExpansionPanel>

            </MudExpansionPanels>

        </MudItem>

    </MudGrid>

    <MudDivider DividerType="DividerType.FullWidth" />

    <div class="mud-width-full d-flex flex-column flex-sm-row justify-center gap-3">
        @if (Generating)
        {
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Stop" Color="Color.Error" Size="Size.Large" OnClick="OnClickStop">Stop</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" Size="Size.Large" OnClick="OnClickGenerateAsync" Disabled="@(!CanStartAutoBuilding)">Generate</MudButton>
        }
        <MudButton Variant="Variant.Filled" Disabled="Generating" Color="Color.Warning" Size="Size.Large" OnClick="OnClickResetAsync">Reset</MudButton>
        <MudButton Variant="Variant.Filled" Disabled="@(Generating || BestTeam.IsEmpty)" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Secondary" Size="Size.Large" OnClick="OnClickLoadIntoEditorAsync">Load Into Editor</MudButton>
    </div>

    @if (Generating)
    {
        <MudProgressLinear Color="Color.Primary" Value="@ProgressValue" Size="Size.Medium" Max="@NumGenerations" />
    }

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudGrid Justify="Justify.SpaceEvenly">
                @for (int i = 0; i < TeamSize; i++)
                {
                    SmartPokemon? p = null;
                    bool locked = false;
                    if (i < _lockedPokemon.Count)
                    {
                        p = _lockedPokemon[i];
                        locked = true;
                    }
                    else if (i < BestTeam.Pokemon.Count)
                    {
                        p = BestTeam.Pokemon[i];
                    }

                    @if (p is not null)
                    {
                        <MudItem xs="4" md="2">
                            <MudPaper Width="fit-content" Height="fit-content">
                                @if (locked)
                                {
                                    <MudIcon Class="ma-1" Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" />
                                }
                                <PokemonMiniCard Pokemon="p" />
                            </MudPaper>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="4" md="2">
                            <MudSkeleton Height="100px"></MudSkeleton>
                        </MudItem>
                    }
                }
            </MudGrid>
        </MudItem>
        @if (!BestTeam.IsEmpty && !Generating)
        {
            <MudItem xs="12">
                <StatsTeamPanel Team="BestTeam" />
            </MudItem>
        }
        else if (!BestTeam.IsEmpty && Generating)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Align="Align.Center" Class="mud-width-full">Team stats will appear once generation finishes</MudText>
            </MudItem>
        }
    </MudGrid>

    <MudExpansionPanels MultiExpansion="true" hidden="@(UniqueTeamsSorted.Count <= 0)">
        <MudExpansionPanel Text="Generation Graph" Expanded="true">
            <div class="mud-width-full" style="min-height: 350px;">
                <ApexCharts.ApexChart @ref="_chart"
                                      TItem="GenerationDataPoint"
                                      Title=""
                                      Options="_options"
                                      XAxisType="ApexCharts.XAxisType.Numeric">
                    <ApexCharts.ApexPointSeries TItem="GenerationDataPoint"
                                                Name="Highest Fitness"
                                                XValue="@(e => e.GenerationNumber)"
                                                YValue="@(e => (int)Math.Round(BestOverallFitness * 1000))"
                                                SeriesType="ApexCharts.SeriesType.Line"
                                                Stroke="@(new ApexCharts.SeriesStroke {Color="#ff7575", DashSpace = 0, Width = 3 })" />

                    <ApexCharts.ApexPointSeries TItem="GenerationDataPoint"
                                                Name="Average Fitness"
                                                XValue="@(e => e.GenerationNumber)"
                                                YValue="@(e => (int)Math.Round(e.AverageFitness))"
                                                SeriesType="ApexCharts.SeriesType.Line"
                                                Stroke="@(new ApexCharts.SeriesStroke {Color="#7fd67f", DashSpace = 2, Width = 2 })" />

                </ApexCharts.ApexChart>
            </div>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Search Coverage" Expanded="true">

            <MudText Typo="Typo.body2" Class="mb-2">
                @_testedCompositions.Count.ToString("N0") of @TotalPossibleTeams.ToString("N0") possible teams tested
                @if (TotalPossibleTeams > 0)
                {
                    <text>(@((100.0 * _testedCompositions.Count / TotalPossibleTeams).ToString("0.###"))%)</text>
                }
            </MudText>

            <div class="mud-width-full" style="min-height: 350px;">
                <ApexCharts.ApexChart @ref="_coverageChart"
                                      TItem="GenerationDataPoint"
                                      Title=""
                                      Options="_coverageOptions"
                                      XAxisType="ApexCharts.XAxisType.Numeric">
                    <ApexCharts.ApexPointSeries TItem="GenerationDataPoint"
                                                Name="Distinct Teams Tested"
                                                XValue="@(e => e.GenerationNumber)"
                                                YValue="@(e => e.TestedCombinations)"
                                                SeriesType="ApexCharts.SeriesType.Line"
                                                Stroke="@(new ApexCharts.SeriesStroke {Color="#7fc8ff", DashSpace = 0, Width = 3 })" />
                </ApexCharts.ApexChart>
            </div>
        </MudExpansionPanel>

        <MudExpansionPanel Text="Alternate Teams" Expanded="false">

            <MudText Typo="Typo.caption" Class="mb-2">
                Best @UniqueTeamsSorted.Count distinct teams found across the whole run (top @(Math.Max(1, PopulationSize / 10)) tracked)
            </MudText>

            @foreach ((double fitness, PokemonTeam team) in UniqueTeamsSorted)
            {
                <MudPaper Outlined="true" Class="ma-1" Style="background: var(--mud-palette-background); width: fit-content;">
                    <MudText Typo="Typo.caption">Fitness = @((int)(fitness * 1000))</MudText>
                    <PokemonTeamCard Team="team" />
                </MudPaper>
            }

        </MudExpansionPanel>
    </MudExpansionPanels>

</MudStack>

<PageFooter />

@code {
    private PokemonBox? _selectedBox;
    public PokemonBox? SelectedBox
    {
        get => _selectedBox;
        set
        {
            _selectedBox = value;
            _lockedPokemon.Clear();
        }
    }

    private List<SmartPokemon> _lockedPokemon = [];

    private IDisposable? registration;

    private PokemonTeamGeneticAlgorithm GeneticAlgorithm = new PokemonTeamGeneticAlgorithm();
    private PokemonTeam BestTeam = new PokemonTeam();
    private List<Tuple<double, PokemonTeam>> UniqueTeamsSorted = new();
    private readonly HashSet<string> _uniqueTeamSignatures = new();

    // every distinct team composition the GA has evaluated across the whole run, valid or not -
    // backs the "Search Coverage" chart/readout
    private readonly HashSet<string> _testedCompositions = new();
    private long TotalPossibleTeams = 0;

    // how many of the run's best teams to keep in the "Alternate Teams" panel - tied to
    // population size so a bigger search keeps proportionally more alternates
    private int MaxAlternateTeams => Math.Max(1, PopulationSize / 10);
    private bool _renderDuringGenerating = true;

    private int _teamSize = 6;
    public int TeamSize
    {
        get => _teamSize;
        set
        {
            _teamSize = value;
            if (_lockedPokemon.Count >= value)
            {
                _lockedPokemon.RemoveRange(value - 1, _lockedPokemon.Count - (value - 1));
            }
            if (BestTeam.Pokemon.Count > value)
            {
                BestTeam.Pokemon.RemoveRange(value, BestTeam.Pokemon.Count - (value));
            }
            StateHasChanged();
        }
    }

    public bool CanStartAutoBuilding
    {
        get
        {
            return TeamSize < (
            ((SelectedBox?.Pokemon.Any(p => p.IsMega)).GetValueOrDefault() ? 1 : 0)
            + ((SelectedBox?.Pokemon.Any(p => p.IsGmax)).GetValueOrDefault() ? 1 : 0)
            + (SelectedBox?.Pokemon.Count(p => !p.IsMega && !p.IsGmax))
            );
        }
    }

    private bool Generating = false;
    private int GenerationsRan { get; set; } = 0;
    private int ProgressValue { get; set; } = 0;

    private int NumGenerations = 50;
    private int PopulationSize = 250;

    private double BestOverallFitness = 0;

    public AutobuilderWeightings GenerationParameters = new();

    private class GenerationDataPoint
    {
        public int GenerationNumber;
        public double AverageFitness;
        public long TestedCombinations;
    }

    private ApexCharts.ApexChart<GenerationDataPoint>? _chart;
    private ApexCharts.ApexChart<GenerationDataPoint>? _coverageChart;

    private ApexCharts.ApexChartOptions<GenerationDataPoint> _options = new()
    {
        Title = new ApexCharts.Title()
        {
            Style = new ApexCharts.TitleStyle()
            {
                FontFamily = "var(--mud-typography-subtitle1-family)",
                FontWeight = "normal",
                FontSize = "1rem",
            },

            Align = ApexCharts.Align.Center,
            OffsetY = 25,
        },

        Chart = new ApexCharts.Chart()
        {
            Toolbar = new ApexCharts.Toolbar
            {
                Show = false
            },
            Background = "transparent",
            FontFamily = "var(--mud-typography-subtitle1-family);",
            Width = "100%",
            Height = "100%",
        },

        PlotOptions = new ApexCharts.PlotOptions()
        {
            Bar = new ApexCharts.PlotOptionsBar
            {
                Horizontal = true,
            }
        },

        Xaxis = new ApexCharts.XAxis()
        {
            DecimalsInFloat = 0,
        }
    };

    private ApexCharts.ApexChartOptions<GenerationDataPoint> _coverageOptions = new()
    {
        Chart = new ApexCharts.Chart()
        {
            Toolbar = new ApexCharts.Toolbar
            {
                Show = false
            },
            Background = "transparent",
            FontFamily = "var(--mud-typography-subtitle1-family);",
            Width = "100%",
            Height = "100%",
        },

        Xaxis = new ApexCharts.XAxis()
        {
            DecimalsInFloat = 0,
        }
    };

    protected override bool ShouldRender()
    {
        return !Generating
        || _renderDuringGenerating;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            registration =
                NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);

            // load the parameters from the profile
            GenerationParameters = Profile.AutobuilderParams;

            // set generation ran callback event
            GeneticAlgorithm.GenerationRan += HandleGenerationRan;

            StateHasChanged();
        }
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        GeneticAlgorithm.Stop();
        _ = Profile.SetAutobuilderParamsAsync(GenerationParameters);
        return ValueTask.CompletedTask;
    }

    protected override Task OnParametersSetAsync()
    {
        if (SelectedBox is null)
        {
            SelectedBox = Profile.PokemonStorage.Boxes.FirstOrDefault();
        }

        GenerationParameters = Profile.AutobuilderParams;

        return base.OnParametersSetAsync();
    }

    public void Dispose() => registration?.Dispose();

    public void OnClickType(string typeName)
    {
        GenerationParameters.Types[typeName] = !GenerationParameters.Types[typeName];
        StateHasChanged();
    }

    public async Task OnClickGenerateAsync()
    {
        Generating = true;
        GenerationsRan = 0;
        ProgressValue = 0;
        BestOverallFitness = 0;
        UniqueTeamsSorted.Clear();
        _uniqueTeamSignatures.Clear();
        _testedCompositions.Clear();

        if (_chart is not null)
        {
            await _chart.UpdateSeriesAsync(true);
        }
        if (_coverageChart is not null)
        {
            await _coverageChart.UpdateSeriesAsync(true);
        }

        // save the params into local storage
        _ = Profile.SetAutobuilderParamsAsync(GenerationParameters);

        AutobuilderWeightings weightingsCopy = new(GenerationParameters);
        weightingsCopy.AllowMultipleMegas = Profile.AllowMultipleMegas;
        weightingsCopy.AllowMultipleGmax = Profile.AllowMultipleGmax;

        PokemonTeam lockedMembers = new();
        lockedMembers.Pokemon.AddRange(_lockedPokemon);
        for (var i = _lockedPokemon.Count; i < TeamSize; i++)
        {
            lockedMembers.Pokemon.Add(null);
        }

        // total distinct team compositions reachable given the current box/locks - the
        // denominator for the "Search Coverage" readout. Locked slots don't vary, so only the
        // choice of unlocked members from the remaining pool contributes to the count.
        int unlockedSlots = TeamSize - _lockedPokemon.Count;
        int availablePool = (SelectedBox?.Pokemon.Count ?? 0) - _lockedPokemon.Count;
        TotalPossibleTeams = BinomialCoefficient(availablePool, unlockedSlots);

        GeneticAlgorithm.Initialize(
            PopulationSize
            , SelectedBox!
            , lockedMembers
            , weightingsCopy);
        GeneticAlgorithm.RunInBackground();

        StateHasChanged();
    }

    public void OnClickStop()
    {
        GeneticAlgorithm.Stop();

        Generating = false;
        StateHasChanged();
    }

    public async Task OnClickResetAsync()
    {
        BestTeam.Pokemon.Clear();
        UniqueTeamsSorted.Clear();
        _uniqueTeamSignatures.Clear();
        _testedCompositions.Clear();
        TotalPossibleTeams = 0;
        if (_chart is not null)
        {
            await _chart.UpdateSeriesAsync(true);
        }
        if (_coverageChart is not null)
        {
            await _coverageChart.UpdateSeriesAsync(true);
        }
        GenerationsRan = 0;
        ProgressValue = 0;
        BestOverallFitness = 0;
        StateHasChanged();
    }

    public async Task OnClickLoadIntoEditorAsync()
    {
        await Session.SetTeamAsync(BestTeam);
        await Profile.SetAutobuilderParamsAsync(GenerationParameters);

        NavigationManager.NavigateTo("/");
    }

    public void OnClickPokemon(SmartPokemon clickedPokemon)
    {
        if (_lockedPokemon.Contains(clickedPokemon))
        {
            _lockedPokemon.Remove(clickedPokemon);
        }
        else if (_lockedPokemon.Count < TeamSize - 1)
        {
            _lockedPokemon.Add(clickedPokemon);
        }
        else
        {
            Snackbar.Add($"Can't lock Pokémon {clickedPokemon.ToString()} because all team slots would be full.", Severity.Warning);
        }
        StateHasChanged();
    }

    // called after each generation is completed
    void HandleGenerationRan(PokemonTeamGeneticAlgorithm geneticAlgorithm)
    {
        if (geneticAlgorithm.BestChromosome is null)
            return;

        IReadOnlyList<PokemonTeamChromosome> population = geneticAlgorithm.CurrentPopulation;

        _renderDuringGenerating = RecordGenerationResult(geneticAlgorithm.BestChromosome, population);
        GenerationsRan++;

        double averageFitness = population.Count > 0
            ? population.Average(c => c.Fitness.GetValueOrDefault())
            : 0;

        // always update the charts, even on generations that don't otherwise trigger a page
        // re-render - this is what gives the "live" graphs while the GA is running
        if (_chart is not null)
        {
            _chart.AppendDataAsync([new()
            {
                GenerationNumber = GenerationsRan
                , AverageFitness = averageFitness * 1000
            }]);
        }

        if (_coverageChart is not null)
        {
            _coverageChart.AppendDataAsync([new()
            {
                GenerationNumber = GenerationsRan
                , TestedCombinations = _testedCompositions.Count
            }]);
        }

        if ((GenerationsRan % (NumGenerations/Math.Min(50, NumGenerations))) == 0)
        {
            ProgressValue = GenerationsRan;
            _renderDuringGenerating = true;
        }

        if (ProgressValue >= NumGenerations)
        {
            ProgressValue = GenerationsRan;
            _renderDuringGenerating = true;
            OnClickStop();
        }

        StateHasChanged();
    }

    // updates BestTeam bookkeeping for this generation's best chromosome, and records the whole
    // population against _testedCompositions/UniqueTeamsSorted; returns true if there's a new
    // overall-best team (used to decide whether the page itself needs a full re-render,
    // separately from the chart which always updates)
    bool RecordGenerationResult(PokemonTeamChromosome bestChromosome, IReadOnlyList<PokemonTeamChromosome> population)
    {
        double bestFitness = bestChromosome.Fitness.GetValueOrDefault();

        // every distinct composition the GA has evaluated this generation, valid or not - backs
        // the "Search Coverage" chart/readout. Cheaper than GetTeam() per chromosome since it
        // reads gene values directly instead of allocating a PokemonTeam/List for each one.
        foreach (PokemonTeamChromosome chromosome in population)
        {
            _testedCompositions.Add(chromosome.GetCompositionKey());
        }

        RecordAlternateTeams(population);

        if (bestFitness <= BestOverallFitness)
            return false;

        PokemonTeam bestTeam = bestChromosome.GetTeam();
        SortGeneratedTeam(ref bestTeam);
        BestTeam = bestTeam;

        BestOverallFitness = bestFitness;
        return true;
    }

    // keeps the best-scoring MaxAlternateTeams distinct teams seen across the *entire* run (not
    // just each generation's single best), so the "Alternate Teams" panel has a meaningfully
    // diverse set of good options even after the GA has converged on one dominant team
    void RecordAlternateTeams(IReadOnlyList<PokemonTeamChromosome> population)
    {
        foreach (PokemonTeamChromosome chromosome in population)
        {
            if (chromosome.Fitness is not double fitness || fitness <= 0)
                continue;

            // skip anything that clearly can't make the cut before paying for GetTeam()'s
            // allocation - most of a converged population fails this check every generation
            if (UniqueTeamsSorted.Count >= MaxAlternateTeams && fitness <= UniqueTeamsSorted[^1].Item1)
                continue;

            string key = chromosome.GetCompositionKey();
            if (_uniqueTeamSignatures.Contains(key))
                continue;

            PokemonTeam team = chromosome.GetTeam();
            SortGeneratedTeam(ref team);

            _uniqueTeamSignatures.Add(key);
            int insertIndex = UniqueTeamsSorted.FindIndex(tuple => tuple.Item1 <= fitness);
            if (insertIndex == -1)
            {
                UniqueTeamsSorted.Add(new Tuple<double, PokemonTeam>(fitness, team));
            }
            else
            {
                UniqueTeamsSorted.Insert(insertIndex, new Tuple<double, PokemonTeam>(fitness, team));
            }

            if (UniqueTeamsSorted.Count > MaxAlternateTeams)
            {
                Tuple<double, PokemonTeam> worst = UniqueTeamsSorted[^1];
                UniqueTeamsSorted.RemoveAt(UniqueTeamsSorted.Count - 1);
                _uniqueTeamSignatures.Remove(worst.Item2.GetCompositionKey());
            }
        }
    }

    private static long BinomialCoefficient(int n, int k)
    {
        if (k < 0 || k > n)
            return 0;

        k = Math.Min(k, n - k);
        long result = 1;
        for (int i = 0; i < k; i++)
        {
            result = result * (n - i) / (i + 1);
        }
        return result;
    }

    private void SortGeneratedTeam(ref PokemonTeam generatedTeam)
    {
        var locked = generatedTeam.Pokemon.Where(p => p != null && _lockedPokemon.Contains(p)).ToList();

        var unlocked = generatedTeam.Pokemon
            .Where(p => p == null || !_lockedPokemon.Contains(p))
            .ToList();

        unlocked.Sort((a, b) =>
        {
            if (a == null && b == null) return 0;
            if (a == null) return 1;
            if (b == null) return -1;
            return a.Id.CompareTo(b.Id);
        });

        generatedTeam.Pokemon = locked.Concat(unlocked).ToList();
    }
}
