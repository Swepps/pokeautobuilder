<MudGrid>

    @if (InlineLabel)
    {
        <MudItem xs="3">
            <div class="d-flex justify-end" style="text-align: end;">
                <MudText Typo="Typo.caption">
                    @($"{Name}:")
                </MudText>
            </div>
        </MudItem>

        <MudItem xs="9">
            <MudTooltip Text="@Tooltip" Placement="Placement.Bottom" RootClass="mud-width-full">
                <MudSlider @bind-Value="Value" Size="@Size" Min="0" Max="1" Step="0.05" Variant="Variant.Filled" Disabled="Disabled" />
            </MudTooltip>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudTooltip Text="@Tooltip" Placement="Placement.Bottom" RootClass="mud-width-full">
                <MudSlider @bind-Value="Value" Size="@Size" Min="0" Max="1" Step="0.05" Variant="Variant.Filled" Disabled="Disabled" >
                    <MudText Typo="Typo.caption">
                        @Name
                    </MudText>
                </MudSlider>
            </MudTooltip>
        </MudItem>
    }
</MudGrid>

@code {
    protected double _value;

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    #pragma warning disable BL0007
    [Parameter]
    public double Value
    {
        get => _value;
        set
        {
            if (_value != value)
            {
                _value = value;
                ValueChanged.InvokeAsync((double)value);
            }
        }
    }
    #pragma warning restore BL0007

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool InlineLabel { get; set; } = false;

    [Parameter]
    public Size Size { get; set; } = Size.Small;

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }
}
