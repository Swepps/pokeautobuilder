@using PokeAutobuilder.Shared.Panes
@using PokemonDataModel

@using Type = PokeApiNet.Type

<MudPaper Style="background: var(--mud-palette-background)" Elevation="4">
	<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
		<MudTabPanel Text="Score">
			<MudStack Class="pa-4">
				<TeamScorePane Team="@Team" />
			</MudStack>
		</MudTabPanel>
		<MudTabPanel Text="Coverage">
			<MudStack Class="pa-4">
				<PokemonTeamDefensePane Team="@Team" />
				<PokemonTeamCoveragePane Team="@Team" />
			</MudStack>
		</MudTabPanel>
		<MudTabPanel Text="Stats">
			<MudStack Class="pa-4">
				<PokemonTeamStatsChartPane Team="@Team"/>
			</MudStack>
		</MudTabPanel>
	</MudTabs>
</MudPaper>

@code {
	[Parameter]
	public PokemonTeam? Team { get; set; }

	private PokemonTeam? _prevTeam;
	private bool _shouldRender = true;

	protected override void OnParametersSet()
	{
		_shouldRender = Team != _prevTeam;
		_prevTeam = Team is null ? null : new PokemonTeam(Team);
	}

	protected override bool ShouldRender() => _shouldRender;
}
