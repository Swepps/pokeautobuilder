@using PokemonDataModel
@using PokeAutobuilder.Source.Services;
@using PokeAutobuilder.Shared.Cards
@using PokeApiNet
@using Utility

@using static PokeAutobuilder.Pages.TeamBuilderPage
@using Type = PokeApiNet.Type

@inject ProfileService Profile
@inject SessionService Session
@inject PokeApiService PokeApiService
@inject IDialogService DialogService

<MudPaper Elevation="4" Class="d-flex flex-column align-center justify-center mud-width-full pa-2" Outlined="true" >

    <MudAutocomplete T="IPokemonSearchable" Label="Pokémon" @bind-Value="PokemonSearchValue" SearchFunc="@(SearchFunc!)"
    ResetValueOnEmptyText="true" Disabled="@_locked" MaxItems="50"
    CoerceText="true" CoerceValue="false" ShowProgressIndicator="true">
        <MoreItemsTemplate>
            <MudText Align="Align.Center" Typo="Typo.body1">
                ...                    
            </MudText>
            <MudText Align="Align.Center" Typo="Typo.body2">
                50 results shown. Start typing to look for more.
            </MudText>
        </MoreItemsTemplate>
    </MudAutocomplete>

    @if (Pokemon is not null)
    {
        <div style="height: 50px; margin-top: 5px;">
            @if (_pokemonSearchValueVarieties.Count > 1
                    && !_locked)
            {
                <MudSelect Dense="true" T="string" Label="Form" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                           @bind-Value="_PokemonFormName" ToStringFunc="@((string formName) => StringUtils.PrettifyString(formName))" >
                    @foreach (var v in _pokemonSearchValueVarieties)
                    {
                        <MudSelectItem Value="@v.Name" />
                    }
                </MudSelect>
            }
        </div>

        <CascadingValue Value="ActiveRuleset">
            <PokemonCard Pokemon="Pokemon" IsNameDisplayed="false" />
        </CascadingValue>
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="mt-2">
            <MudTooltip Text="Details">
                <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.OpenInFull" OnClick="OnClickDetails"></MudIconButton>
            </MudTooltip>
            @if (Lockable)
            {
                <MudTooltip Text="Lock slot for Auto Builder">
                    <MudToggleIconButton @bind-Toggled="@Locked" Color="Color.Dark" ToggledColor="Color.Primary"
                                         Icon="@Icons.Material.Filled.LockOpen"
                                         ToggledIcon="@Icons.Material.Filled.Lock" />
                </MudTooltip>
            }
            @ExtraButtons
        </MudButtonGroup>
    }
    else if (PokemonSearchValue is not null)
    {
        if (_errorFetchingPokemon)
        {
            <MudText Typo="Typo.caption">
                Error Fetching @PokemonSearchValue.ToString()
                from API
            </MudText>
        }
        else
        {
            <MudProgressCircular Color="Color.Default" Indeterminate="true" Class="mt-8 mb-8" />
        }        
    }
    else
    {
        <MudButtonGroup Color="Color.Primary" Variant="Variant.Text" Size="Size.Small" Class="mt-2">
            @if (Lockable)
            {
                <MudTooltip Text="Lock slot for Auto Builder">
                    <MudToggleIconButton @bind-Toggled="@Locked" Color="Color.Dark" ToggledColor="Color.Primary"
                                         Icon="@Icons.Material.Filled.LockOpen"
                                         ToggledIcon="@Icons.Material.Filled.Lock" />
                </MudTooltip>
            }
            @ExtraButtons
        </MudButtonGroup>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public Func<string, CancellationToken, Task<IEnumerable<IPokemonSearchable>>>? SearchFunc { get; set; }

    [Parameter]
    public RenderFragment? ExtraButtons { get; set; }

    [Parameter]
    public EventCallback<PokemonSearchBox> OnPokemonChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnLockChanged { get; set; }

    // Threaded into the Details dialog so its coverage/defense panes reflect the right ruleset -
    // a dialog opened via DialogService.ShowAsync isn't a descendant of this component in the
    // render tree, so a plain CascadingValue here wouldn't reach it; it has to go as a dialog
    // parameter instead.
    [Parameter]
    public BoxRules? ActiveRuleset { get; set; }

    [Parameter]
    public bool Lockable { get; set; } = false;

    // currently selected pokemon
    private SmartPokemon? _pokemon;
    public SmartPokemon? Pokemon
    {
        get => _pokemon;
        set
        {
            _ = SetPokemonAsync(value);
        }
    }
    private SmartPokemon? _prevPokemon;

    private List<NamedApiResource<Pokemon>> _pokemonSearchValueVarieties = new();
    private bool _pokemonSearchValueVarietiesChanged = true;

    // the string which holds the last valid search result from the search bar
    private IPokemonSearchable? _pokemonSearchValue;
    public IPokemonSearchable? PokemonSearchValue
    {
        get { return _pokemonSearchValue; }
        set 
        {
            _pokemonSearchValue = value;
            _ = OnUpdatedSearchValue();
        }
    }
    private IPokemonSearchable? _prevPokemonSearchValue;

    // the string used in the form selector
    private string? _pokemonFormName;
    public string? _PokemonFormName
    {

        get { return _pokemonFormName; }
        set
        {
            _pokemonFormName = value;
            _ = OnUpdatedPokemonForm();
        }
    }
    private string? _prevPokemonFormName;

    // only relevant if this search box is part of a team
    private bool _locked = false;
    public bool Locked
    {
        get { return _locked; }
        set
        {
            _locked = value;
            _ = OnLockChanged.InvokeAsync(_locked);
        }
    }
    private bool _prevLocked = false;

    private bool _errorFetchingPokemon = false;

    public void Refresh()
    {
        StateHasChanged();
    }

    public async Task OnUpdatedPokemonForm()
    {        
        // don't bother if the form name is the same as the current pokemon
        if (_PokemonFormName is null || (Pokemon != null && _PokemonFormName == Pokemon.Name))
            return;

        string form = _PokemonFormName;
        await SearchPokemon(null);
        await SearchPokemon(form);
    }

    public async Task OnUpdatedSearchValue()
    {
        if (PokemonSearchValue is not null)
        {
            var varieties = (await PokemonSearchValue.GetAllVarietiesAsync(PokeApiService)).ToList();
            await LoadVarietiesAsync(varieties);
            await SearchPokemon(_pokemonSearchValueVarieties[0].Name);
        }
        else
        {
            await SearchPokemon(null);
        }
    }

    // Every variety's PokemonForm data (needed to tell whether it's a valid pick under the active
    // ruleset), fetched once per species selection and cached here - so a later ruleset change
    // (RefilterVarieties) can redecide which varieties to show without an extra round of API calls.
    private List<(NamedApiResource<Pokemon> Variety, PokemonForm? Form)> _varietiesWithForms = [];

    private async Task LoadVarietiesAsync(List<NamedApiResource<Pokemon>> varieties)
    {
        _varietiesWithForms = [];
        foreach (NamedApiResource<Pokemon> variety in varieties)
        {
            // only one variety exists - nothing to filter, and no point spending a request on its form
            PokemonForm? form = varieties.Count > 1 ? await PokeApiService.GetPokemonFormAsync(variety.Name) : null;
            _varietiesWithForms.Add((variety, form));
        }

        RefilterVarieties();
    }

    // Forms/varieties (regional forms, megas, gmax) aren't all available in every game a species
    // itself appears in - e.g. Voltorb-Hisui wasn't obtainable in Red & Blue even though Voltorb
    // was. Filters the ones this ruleset's generation/mega/gmax rules wouldn't allow, so they can't
    // be picked from the Form dropdown in the first place. An already-selected variety that becomes
    // incompatible after a ruleset change is left alone rather than force-cleared, matching how a
    // box keeps a since-incompatible Pokemon rather than evicting it. Synchronous and re-callable
    // whenever the ruleset changes, since it just re-decides against the already-fetched forms.
    private void RefilterVarieties()
    {
        BoxRules rules = ActiveRuleset ?? BoxRules.Unrestricted();
        List<NamedApiResource<Pokemon>> compatible = _varietiesWithForms
            // fail open when a form couldn't be resolved (no lookup attempted, or a lookup miss)
            // rather than silently hiding an otherwise-valid variety
            .Where(vf => rules.Generation is null || vf.Form is null || IsFormCompatible(vf.Form, rules))
            .Select(vf => vf.Variety)
            .ToList();

        // never filter down to nothing - if every variety somehow got excluded (a resolution bug),
        // showing the unfiltered list is far less disruptive than an empty Form dropdown
        _pokemonSearchValueVarieties = compatible.Count > 0
            ? compatible
            : _varietiesWithForms.Select(vf => vf.Variety).ToList();
        _pokemonSearchValueVarietiesChanged = true;
    }

    private static bool IsFormCompatible(PokemonForm form, BoxRules rules)
    {
        if (form.IsMega && !rules.AllowMegas)
            return false;

        if (form.FormName == "gmax" && !rules.AllowGmax)
            return false;

        int? formGeneration = PokemonVersionGroup.GenerationForApiName(form.VersionGroup.Name);
        return formGeneration is null || formGeneration <= rules.Generation;
    }

    public async Task SearchPokemon(string? pokemonName)
    { 
        _errorFetchingPokemon = false;

        // clear pokemon
        if (pokemonName is null)
        {
            _pokemon = null;
            _pokemonFormName = null;
            _varietiesWithForms = [];
            _pokemonSearchValueVarieties.Clear();
            _ = OnPokemonChanged.InvokeAsync(this);
        }
        else
        {
            // reuse an already-loaded selection instead of re-fetching (would reset its moves)
            SmartPokemon? searchedPokemon = PokemonSearchValue is SmartPokemon existingPokemon && existingPokemon.Name == pokemonName
                ? existingPokemon
                : await PokeApiService.GetPokemonAsync(pokemonName);
            if (searchedPokemon is not null)
                await SetPokemonAsync(searchedPokemon);
            else
                _errorFetchingPokemon = true;
        }
    }

    public async Task SetPokemonAsync(SmartPokemon? pokemon)
    {
        SmartPokemon? before = _pokemon;

        _pokemon = pokemon;
        if (_pokemon is not null)
        {
            _pokemonSearchValue = new SmartPokemonEntry(_pokemon.Id, _pokemon.Species);
            _pokemonFormName = _pokemon.Name;
            PokemonSpecies species = await _pokemon.GetSpeciesAsync(PokeApiService);
            List<NamedApiResource<Pokemon>> varieties = species.Varieties.Select(v => v.Pokemon).ToList();
            await LoadVarietiesAsync(varieties);
        }
        else
        {
            _pokemonSearchValue = null;
            _pokemonFormName = null;
            _varietiesWithForms = [];
            _pokemonSearchValueVarieties.Clear();
        }

        if (before != _pokemon)
        {
            _ = OnPokemonChanged.InvokeAsync(this);
        }

        StateHasChanged();
    }

    // pokemon ability functionality
    public void OnChangeAbility(string? value)
    {
        // SetChosenAbility uses a string to find an ability with a matching name
        if (value is not null && _pokemon is not null)
            _pokemon.SelectAbility(value);
    }

    public async Task OnClickDetails()
    {
        var parameters = new DialogParameters();
        parameters.Add("Pokemon", Pokemon);
        parameters.Add("ActiveRuleset", ActiveRuleset);

        var dialog = await DialogService.ShowAsync<PokemonDetailsDialog>(StringUtils.PrettifyString(Pokemon!.Name), parameters);
        var result = await dialog.Result;

        if (result is not null
            && !result.Canceled && result.Data is SmartPokemon)
        {
            // update the Profile storage if this pokemon exists in there
            SmartPokemon? pokemon = result.Data as SmartPokemon;
            if (pokemon is not null
                && Profile.FindPokemonBoxForPokemon(pokemon) is not null)
            {
                await Profile.UpdatePokemonStorageAsync();
            }

            // fire and forget
            _ = Session.UpdatePokemonTeamAsync();

            StateHasChanged();
        }
    }

    // The Pokemon's own type badge (rendered via PokemonCard, cascaded ActiveRuleset) needs to
    // redraw when the ruleset itself changes even though none of the other tracked fields did -
    // e.g. editing a box's ruleset while its Add panel still shows a previously-searched Pokemon.
    // Compared by RulesetId rather than the BoxRules reference/record equality, since that's the
    // actual identity that determines whether a redraw would show anything different.
    private RulesetId? _prevActiveRulesetId;

    // Re-decides which already-fetched varieties are pickable whenever the ruleset itself changes
    // (e.g. the box's ruleset is edited while this search box still shows a previously-picked
    // Pokemon) - RefilterVarieties is synchronous, so this doesn't need to be *Async.
    protected override void OnParametersSet()
    {
        if (_prevActiveRulesetId != ActiveRuleset?.Id && _varietiesWithForms.Count > 0)
        {
            RefilterVarieties();
        }
    }

    protected override bool ShouldRender()
    {
        return _prevPokemon != _pokemon
        || _prevPokemonSearchValue != _pokemonSearchValue
        || _prevPokemonFormName != _pokemonFormName
        || _prevLocked != _locked
        || _pokemonSearchValueVarietiesChanged
        || _prevActiveRulesetId != ActiveRuleset?.Id;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        _prevPokemon = _pokemon;
        _prevPokemonSearchValue = _pokemonSearchValue;
        _prevPokemonFormName = _pokemonFormName;
        _prevLocked = _locked;
        _pokemonSearchValueVarietiesChanged = false;
        _prevActiveRulesetId = ActiveRuleset?.Id;
    }
}
