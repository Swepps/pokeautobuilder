@using AutoBuilder
@using PokeAutobuilder.Shared.Cards
@using PokeAutobuilder.Source.Services
@using PokemonDataModel
@using Utility

@inject SessionService Session
@inject ProfileService Profile
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@implements IDisposable

@page "/autobuilder"

<MudStack AlignItems="AlignItems.Start">

    <MudGrid>
        <MudItem xs="12" md="6">

            <MudExpansionPanels>
                <MudExpansionPanel Text="Box Settings" Expanded="true">

                    <MudSelect T="PokemonBox" Label="Select a box to generate a team from" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                               @bind-Value="SelectedBox" Disabled="Generating" FullWidth="true">
                        @foreach (PokemonBox box in Profile.PokemonStorage.Boxes)
                        {
                            <MudSelectItem T="PokemonBox" Value="box">
                                @box.Name
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <CascadingValue Value="@_lockedPokemon">
                        <PokemonStorageBox PokemonCollection="@(SelectedBox is not null ? SelectedBox.Pokemon : new())" OnClickPokemon="OnClickPokemon" />
                    </CascadingValue>

                </MudExpansionPanel>
            </MudExpansionPanels>

        </MudItem>

        <MudItem xs="12" md="6">

            <MudExpansionPanels>
                <MudExpansionPanel Text="Generation Settings" Expanded="true">

                    <MudStack>
                        <MudSlider Disabled="Generating" Min="1" Max="6" Step="1" @bind-Value="@TeamSize" Variant="Variant.Filled" TickMarks="true">Team Size</MudSlider>
                        <MudNumericField Disabled="Generating" @bind-Value="NumGenerations" Label="Generations" Variant="Variant.Text" Min="10" Max="200" Step="10" />
                        <MudNumericField Disabled="Generating" @bind-Value="PopulationSize" Label="Population Size" Variant="Variant.Text" Min="50" Max="1000" Step="50" />
                    </MudStack>

                </MudExpansionPanel>

                <MudExpansionPanel Text="Generation Parameters" Expanded="false">

                    <MudText Typo="Typo.subtitle1">Types</MudText>
                    <MudText Typo="Typo.caption">Click a type to toggle it. Disabled types won't be considered during team generation</MudText>

                    <div class="mt-1 mb-1">
                        @foreach (string t in Globals.AllTypes)
                        {
                            <MudButton OnClick="() => OnClickType(t)" Style="height: 40px; min-width: 40px" Class="pa-0" Disabled="Generating">
                                <MudTooltip Text="@StringUtils.PrettifyString(t)" RootClass="d-flex">
                                    @if (Generating)
                                    {
                                        <MudImage Src="@StringUtils.DisabledTypeImgFromName(t)" alt="@t" Height="30" Class="ma-1" />
                                    }
                                    else if (GenerationParameters.Types.ContainsKey(t) && GenerationParameters.Types[t])
                                    {
                                        <MudImage Src="@StringUtils.TypeImgFromName(t)" alt="@t" Height="30" Class="ma-1"/>
                                    }
                                    else
                                    {
                                        <MudImage Src="@StringUtils.DisabledTypeImgFromName(t)" alt="@t" Height="30" Class="ma-1" />
                                    }
                                </MudTooltip>
                            </MudButton>
                        }
                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Attack</MudText>

                    <div class="px-4 mt-1">
                        <MudText Typo="Typo.subtitle2">STAB Coverage</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of STAB coverage</MudText>
                        <WeightingSlider Name="All Types"
                                         InlineLabel="true"
                                            Tooltip="Importance of a team with at least one Pokémon with STAB coverage against each type"
                                            @bind-Value="GenerationParameters.StabAll"
                                            Score="BestTeamScore?.StabAll"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                            Tooltip="Importance of a balanced amount of STAB coverage."
                                            @bind-Value="GenerationParameters.StabBalance"
                                            Score="BestTeamScore?.StabBalance"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                            Tooltip="Importance of a higher amount of STAB coverage."
                                            @bind-Value="GenerationParameters.StabAmount"
                                            Score="BestTeamScore?.StabAmount"
                                            Disabled="Generating" />

                        <MudDivider Class="mb-2" DividerType="DividerType.Inset" />

                        <MudText Typo="Typo.subtitle2">Move Coverage</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of move coverage</MudText>
                        <WeightingSlider Name="All Types"
                                         InlineLabel="true"
                                            Tooltip="Importance of a team with at least one Pokémon with move coverage against each type"
                                            @bind-Value="GenerationParameters.MoveSetAll"
                                            Score="BestTeamScore?.MoveSetAll"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                            Tooltip="Importance of a balanced amount of move coverage"
                                            @bind-Value="GenerationParameters.MoveSetBalance"
                                            Score="BestTeamScore?.MoveSetBalance"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                            Tooltip="Importance of a higher amount of move coverage"
                                            @bind-Value="GenerationParameters.MoveSetAmount"
                                            Score="BestTeamScore?.MoveSetAmount"
                                            Disabled="Generating" />

                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Defense</MudText>

                    <div class="px-4">
                        <MudText Typo="Typo.subtitle2">Resistances</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of type resistances</MudText>

                        <WeightingSlider Name="All Types"
                                         InlineLabel="true"
                                         Tooltip="Importance of a team with at least one Pokémon resistant to each type"
                                         @bind-Value="GenerationParameters.ResistanceAll"
                                         Disabled="Generating" />

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                         Tooltip="Importance of a balanced number of type resistances"
                                         @bind-Value="GenerationParameters.ResistanceBalance"
                                         Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                         Tooltip="Importance of a higher amount of type resistances"
                                         @bind-Value="GenerationParameters.ResistanceAmount"
                                         Disabled="Generating" />

                        <MudDivider Class="mb-2" DividerType="DividerType.Inset" />

                        <MudText Typo="Typo.subtitle2">Weaknesses</MudText>
                        <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of type weaknesses</MudText>

                        <WeightingSlider Name="Balance"
                                         InlineLabel="true"
                                            Tooltip="Importance of a balanced number of type weaknesses"
                                            @bind-Value="GenerationParameters.WeaknessBalance"
                                            Score="BestTeamScore?.WeaknessBalance"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Amount"
                                         InlineLabel="true"
                                            Tooltip="Importance of a lower amount of type weaknesses"
                                            @bind-Value="GenerationParameters.WeaknessAmount"
                                            Score="BestTeamScore?.WeaknessAmount"
                                            Disabled="Generating" />

                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Miscellaneous</MudText>
                    <MudText Typo="Typo.caption">Use the sliders to fine-tune the importance of other misc. attributes</MudText>

                    <div class="px-4">
                        <WeightingSlider Name="Good Coverage On Offensive Pokémon"
                                            Tooltip="Importance of good coverage on offensive Pokémon - e.g. a Pokémon with good offensive stats should have STAB coverage against more types"
                                            @bind-Value="GenerationParameters.CoverageOnOffensive"
                                            Score="BestTeamScore?.CoverageOnOffensive"
                                            Disabled="Generating" />

                        <WeightingSlider Name="Good Resistances On Defensive Pokémon"
                                            Tooltip="Importance of good resistances on defensive Pokémon - e.g. a Pokémon with good defensive stats should also be resistant to more types"
                                            @bind-Value="GenerationParameters.ResistancesOnDefensive"
                                            Score="BestTeamScore?.ResistancesOnDefensive"
                                            Disabled="Generating" />
                    </div>

                    <MudDivider Class="mb-2" />

                    <MudText Typo="Typo.subtitle1">Stat Weightings</MudText>
                    <MudText Typo="Typo.caption">Use the sliders to adjust the importance of base statistics</MudText>

                    <div class="px-4">
                        <WeightingSlider Name="Base Stats"
                                         Size="Size.Medium"
                                         Tooltip="The overall importance of base stats"
                                         @bind-Value="GenerationParameters.BaseStatTotal"
                                         Score="BestTeamScore?.BaseStatTotal"
                                         Disabled="Generating" />

                        <WeightingSlider Name="HP"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the HP base stat"
                                         @bind-Value="GenerationParameters.BaseStatHp"
                                         Score="BestTeamScore?.BaseStatHp"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Attack"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Attack base stat"
                                         @bind-Value="GenerationParameters.BaseStatAtt"
                                         Score="BestTeamScore?.BaseStatAtt"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Defense"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Defense base stat"
                                         @bind-Value="GenerationParameters.BaseStatDef"
                                         Score="BestTeamScore?.BaseStatDef"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Sp. Attack"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Special Attack base stat"
                                         @bind-Value="GenerationParameters.BaseStatSpAtt"
                                         Score="BestTeamScore?.BaseStatSpAtt"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Sp. Defense"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Special Defense base stat"
                                         @bind-Value="GenerationParameters.BaseStatSpDef"
                                         Score="BestTeamScore?.BaseStatSpDef"
                                         Disabled="Generating" />
                        <WeightingSlider Name="Speed"
                                         InlineLabel="true"
                                         Tooltip="Importance of a the Speed base stat"
                                         @bind-Value="GenerationParameters.BaseStatSpe"
                                         Score="BestTeamScore?.BaseStatSpe"
                                         Disabled="Generating" />

                    </div>

                </MudExpansionPanel>

            </MudExpansionPanels>

        </MudItem>

    </MudGrid>

    <MudDivider DividerType="DividerType.FullWidth" />    

    <MudGrid Class="mb-2">
        <MudItem xs="12">
            <MudGrid Justify="Justify.SpaceEvenly">
                @for (int i = 0; i < TeamSize; i++)
                {
                    SmartPokemon? p = null;
                    bool locked = false;
                    if (i < _lockedPokemon.Count)
                    {
                        p = _lockedPokemon[i];
                        locked = true;
                    }
                    else if (i < BestTeam.Pokemon.Count)
                    {
                        p = BestTeam.Pokemon[i];
                    }

                    @if (p is not null)
                    {
                        <MudItem xs="4" md="2">
                            <MudPaper>
                                @if (locked)
                                {
                                    <MudIcon Class="ma-1" Icon="@Icons.Material.Filled.Lock" Color="Color.Primary" />
                                }
                                <PokemonCard Pokemon="p" />
                            </MudPaper>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="4" md="2">
                            <MudSkeleton Height="100px"></MudSkeleton>
                        </MudItem>
                    }
                }
            </MudGrid>
        </MudItem>
        @if (!BestTeam.IsEmpty)
        {
            <MudItem xs="12">
                <StatsTeamPanel Team="BestTeam" />
            </MudItem>
        }
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudStack Row="true">
                @if (Generating)
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Stop" Color="Color.Error" OnClick="OnClickStop">Stop</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.PlayArrow" Color="Color.Success" OnClick="OnClickGenerate" Disabled="@(TeamSize >= SelectedBox?.Pokemon.Count)">Generate</MudButton>
                }
                <MudButton Disabled="Generating" Variant="Variant.Filled" Color="Color.Primary" OnClick="OnClickReset">Reset</MudButton>
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudButton Disabled="@(Generating || BestTeam.IsEmpty)" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Upload" Color="Color.Primary" OnClick="OnClickLoadIntoEditorAsync">Load Into Editor</MudButton>
        </MudItem>
    </MudGrid>

    @if (Generating)
    {
        <MudProgressLinear Color="Color.Primary" Value="@ProgressValue" Size="Size.Medium" Max="@NumGenerations" />
    }
</MudStack>

@code {
    private PokemonBox? _selectedBox;
    public PokemonBox? SelectedBox
    {
        get => _selectedBox;
        set
        {
            _selectedBox = value;
            _lockedPokemon.Clear();
        }
    }

    private List<SmartPokemon> _lockedPokemon = [];

    private IDisposable? registration;

    private PokemonTeamGeneticAlgorithm GeneticAlgorithm = new PokemonTeamGeneticAlgorithm();
    private PokemonTeam BestTeam = new PokemonTeam();
    private AutoBuilderWeightings? BestTeamScore;
    private bool _renderDuringGenerating = true;

    private int _teamSize = 6;
    public int TeamSize
    {
        get => _teamSize;
        set
        {
            _teamSize = value;
            if (_lockedPokemon.Count >= value)
            {
                _lockedPokemon.RemoveRange(value - 1, _lockedPokemon.Count - (value - 1));
            }
            if (BestTeam.Pokemon.Count > value)
            {
                BestTeam.Pokemon.RemoveRange(value, BestTeam.Pokemon.Count - (value));
            }
            StateHasChanged();
        }
    }

    private bool Generating = false;
    private int GenerationsRan { get; set; } = 0;
    private int ProgressValue { get; set; } = 0;

    private int NumGenerations = 50;
    private int PopulationSize = 250;

    private double? GABestChromFitness = 0;
    private double BestOverallFitness = 0;

    public AutoBuilderWeightings GenerationParameters = new(
            AutoBuilderWeightings.MakeDefaultTypeWeightings()
            , resistanceAll: 0.5
            , resistanceBalance: 0.5
            , resistanceAmount: 0.5

            , weaknessBalance: 0.5
            , weaknessAmount: 0.5

            , stabAll: 0.5
            , stabBalance: 0.5
            , stabAmount: 0.5

            , moveSetAll: 0.5
            , moveSetBalance: 0.5
            , moveSetAmount: 0.5

            , coverageOnOffensive: 0.0
            , resistancesOnDefensive: 0.0

            , baseStatTotal: 0.5
            , baseStatHp: 0.5
            , baseStatAtt: 0.5
            , baseStatDef: 0.5
            , baseStatSpAtt: 0.5
            , baseStatSpDef: 0.5
            , baseStatSpe: 0.5
    );

    protected override bool ShouldRender()
    {
        return !Generating
        || _renderDuringGenerating;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            registration =
                NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);

            // load the parameters from the current session
            if (Session.AutobuilderParams is not null)
            {
                GenerationParameters = Session.AutobuilderParams;
            }

            // set generation ran callback event
            GeneticAlgorithm.GenerationRan += HandleGenerationRan;

            StateHasChanged();
        }
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        GeneticAlgorithm.Stop();
        _ = Session.SetAutobuilderParamsAsync(GenerationParameters);
        return ValueTask.CompletedTask;
    }

    protected override Task OnParametersSetAsync()
    {
        if (SelectedBox is null)
        {
            SelectedBox = Profile.PokemonStorage.Boxes.FirstOrDefault();
        }

        return base.OnParametersSetAsync();
    }

    public void Dispose() => registration?.Dispose();

    public void OnClickType(string typeName)
    {
        GenerationParameters.Types[typeName] = !GenerationParameters.Types[typeName];
        StateHasChanged();
    }

    public void OnClickGenerate()
    {
        Generating = true;
        GenerationsRan = 0;
        ProgressValue = 0;
        BestOverallFitness = 0;

        AutoBuilderWeightings weightingsCopy = new(GenerationParameters);

        PokemonTeam lockedMembers = new();
        lockedMembers.Pokemon.AddRange(_lockedPokemon);
        for (var i = _lockedPokemon.Count; i < TeamSize; i++)
        {
            lockedMembers.Pokemon.Add(null);
        }

        GeneticAlgorithm.Initialize(
            PopulationSize
            , SelectedBox!
            , lockedMembers
            , weightingsCopy);
        GeneticAlgorithm.RunInBackground();

        StateHasChanged();
    }

    public void OnClickStop()
    {
        GeneticAlgorithm.Stop();

        Generating = false;
        StateHasChanged();
    }

    public void OnClickReset()
    {
        BestTeamScore = null;
        StateHasChanged();
    }

    public async Task OnClickLoadIntoEditorAsync()
    {
        await Session.SetTeamAsync(BestTeam);
        await Session.SetAutobuilderParamsAsync(GenerationParameters);

        NavigationManager.NavigateTo("/");
    }

    public void OnClickPokemon(SmartPokemon clickedPokemon)
    {
        if (_lockedPokemon.Contains(clickedPokemon))
        {
            _lockedPokemon.Remove(clickedPokemon);
        }
        else if (_lockedPokemon.Count < TeamSize - 1)
        {
            _lockedPokemon.Add(clickedPokemon);
        }
        else
        {
            Snackbar.Add($"Can't lock Pokémon {clickedPokemon.ToString()} because all team slots would be full.", Severity.Warning);
        }
        StateHasChanged();
    }

    protected async Task<IEnumerable<IPokemonSearchable>> SearchAsync(string? searchString, CancellationToken token)
    {
        if (SelectedBox is not null)
        {
            IEnumerable<IPokemonSearchable> list = await SelectedBox.GetListAsync();
            if (String.IsNullOrEmpty(searchString))
                return list;

            return list.Where((p) => p.Name.ToLower().Contains(searchString.ToLower()));
        }

        return Enumerable.Empty<SmartPokemonEntry>();
    }

    // called after each generation is completed
    void HandleGenerationRan(PokemonTeamGeneticAlgorithm geneticAlgorithm)
    {
        if (geneticAlgorithm.BestChromosome is null)
            return;

        PokemonTeam GeneratedTeam = geneticAlgorithm.BestChromosome.GetTeam();
        GABestChromFitness = geneticAlgorithm.BestChromosome.Fitness;

        _renderDuringGenerating = false;

        if (GABestChromFitness > BestOverallFitness)
        {
            BestTeam = GeneratedTeam;
            BestTeamScore = geneticAlgorithm.BestChromosome.WeightingScores;
            BestOverallFitness = (double)GABestChromFitness;
            _renderDuringGenerating = true;
        }

        GenerationsRan++;

        if (GenerationsRan % 5 == 0)
        {
            ProgressValue = GenerationsRan;
            _renderDuringGenerating = true;
            if (ProgressValue >= NumGenerations)
            {
                OnClickStop();
            }
        }

        StateHasChanged();
    }
}
