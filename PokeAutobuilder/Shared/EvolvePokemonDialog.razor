@using PokemonDataModel
@using PokeAutobuilder.Shared.Cards
@using PokeAutobuilder.Shared

@inject PokeApiService PokeApiService

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <CascadingValue Value="ActiveRuleset">
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <PokemonCard Pokemon="@Pokemon" />
                        <MudIcon Icon="@Icons.Material.Filled.DoubleArrow" Size="Size.Large"/>
                        <PokemonCard Pokemon="@SelectedPokemon" />
                    </MudStack>
                </CascadingValue>
            </MudItem>
            <MudItem xs="12" sm="6">
                @if (_noEvolutions)
                {
                    <MudText Typo="Typo.body2">@(Pokemon!.ToString()) has no evolutions!</MudText>
                }
                else if (_noEvolutionsInRuleset)
                {
                    <MudText Typo="Typo.body2">@(Pokemon!.ToString())'s evolutions aren't available in this ruleset.</MudText>
                }
                else if (_evolutions.Count == 0)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else
                {
                    <MudText Typo="Typo.h6">@(Pokemon!.ToString()) evolutions</MudText>
                    <MudPaper Class="pa-1 d-flex" Elevation="0" Square="true">
                        <CascadingValue Value="@_selectedPokemonList" Name="SelectedPokemon">
                            <PokemonStorageBox PokemonCollection="_evolutions" OnClickPokemon="OnSelectPokemon" />
                        </CascadingValue>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Disabled="@(SelectedPokemon is null)">Evolve</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    [Parameter, EditorRequired]
    public SmartPokemon? Pokemon { get; set; }

    [Parameter]
    public BoxRules? ActiveRuleset { get; set; }

    private List<SmartPokemon> _evolutions = [];
    private bool _noEvolutions = false;
    private bool _noEvolutionsInRuleset = false;

    private List<SmartPokemon> _selectedPokemonList = [];
    private SmartPokemon? _selectedPokemon;
    public SmartPokemon? SelectedPokemon
    {
        get => _selectedPokemon;
        set
        {
            _selectedPokemon = value;
            _selectedPokemonList.Clear();
            if (value is not null) _selectedPokemonList.Add(value);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        int? generation = ActiveRuleset?.Generation;
        _evolutions = await PokeApiService.GetNextEvolutions(Pokemon!, generation);

        if (_evolutions.Count == 0)
        {
            // distinguish "genuinely nothing to evolve into" from "this ruleset's generation is too
            // early for any of them" (e.g. Seadra has no evolutions at all vs. Seadra's only
            // evolution, Kingdra, not existing yet under a Gen 1 ruleset) - re-check unrestricted so
            // the message doesn't claim "no evolutions" when there genuinely are some, just not here
            bool hasAnyEvolutions = generation is null
                || (await PokeApiService.GetNextEvolutions(Pokemon!)).Count > 0;

            if (hasAnyEvolutions)
                _noEvolutionsInRuleset = true;
            else
                _noEvolutions = true;
        }
    }

    protected void OnSelectPokemon(SmartPokemon selectedPokemon)
    {
        SelectedPokemon = selectedPokemon;
    }

    protected void Submit() 
    {
        if (Pokemon!.SelectedAbility is not null)
        {
            SelectedPokemon!.SelectAbility(Pokemon!.SelectedAbility.Ability.Name);
        }
        SelectedPokemon!.SelectedMoves = Pokemon.SelectedMoves;
        MudDialog!.Close(DialogResult.Ok(SelectedPokemon));
    }

    void Cancel() => MudDialog!.Cancel();
}
