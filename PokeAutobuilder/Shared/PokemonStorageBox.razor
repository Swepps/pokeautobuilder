@inject ProfileService Profile

@implements IDisposable

@using PokeAutobuilder.Shared.Cards
@using PokeAutobuilder.Source.Services;
@using PokemonDataModel

<MudPaper Class="d-flex mud-width-full mud-height-full pa-2" Style="background: var(--mud-palette-background); min-height: 300px;" Outlined="true" Square="true">
	<div class="d-flex flex-wrap justify-start align-content-start py-1" style="overflow: auto;">
		@foreach (SmartPokemon? p in PokemonCollection!)
		{
			<PokemonMiniCard Pokemon="p" OnClick="OnClickPokemonCard" ArtworkLevel="ArtworkLevel" Variant="@(SelectedPokemon is not null && SelectedPokemon.Contains(p) ? Variant.Outlined : Variant.Filled)" />
		}
	</div>
</MudPaper>

@code {
	[Parameter, EditorRequired]
	public IEnumerable<SmartPokemon>? PokemonCollection { get; set; }

	[Parameter]
	public EventCallback<SmartPokemon> OnClickPokemon { get; set; }

	[CascadingParameter]
	public List<SmartPokemon>? SelectedPokemon { get; set; }

	[CascadingParameter]
	public BoxRules? ActiveRuleset { get; set; }

	// Resolved live (not cached) for the whole grid at once - not per card - so every mini card in
	// this box/list renders at the same art era, and so a global artwork-preference change (not a
	// parameter change - see the OnPreferencesChange subscription below) is picked up correctly.
	private int ArtworkLevel =>
		PokemonArtwork.ResolveGroupLevel(PokemonCollection ?? [], ActiveRuleset?.Generation, Profile.MiniArtworkStyle);

	protected override void OnInitialized()
	{
		Profile.OnPreferencesChange += StateHasChanged;
	}

	public void Dispose()
	{
		Profile.OnPreferencesChange -= StateHasChanged;
	}

	public Task OnClickPokemonCard(SmartPokemon pokemon)
	{
		return OnClickPokemon.InvokeAsync(pokemon);
	}
}
