@inject ProfileService Profile

@implements IDisposable

@using PokeAutobuilder.Shared.Cards
@using PokeAutobuilder.Shared.Panes
@using PokeAutobuilder.Source.Services
@using PokemonDataModel

@if (Team is not null)
{
    <MudDialog>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12">
                    <CascadingValue Value="Team.Ruleset">
                        <MudGrid Justify="Justify.SpaceEvenly">
                            @foreach (SmartPokemon? p in Team.Pokemon)
                            {
                                @if (p is not null)
                                {
                                    <MudItem xs="4" md="2">
                                        <MudPaper>
                                            <PokemonCard Pokemon="p" ArtworkLevel="ArtworkLevel" />
                                        </MudPaper>
                                    </MudItem>
                                }
                            }
                        </MudGrid>
                    </CascadingValue>
                </MudItem>
                <MudItem xs="12">
                    <StatsTeamPanel Team="Team" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" OnClick="Submit">Ok</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    [Parameter]
    public PokemonTeam? Team { get; set; }

    private int ArtworkLevel => Team is null
        ? 0
        : PokemonArtwork.ResolveGroupLevel(
            Team.Pokemon.Where(p => p is not null)!,
            Team.Ruleset.Generation,
            Profile.LargeArtworkStyle
        );

    protected override void OnInitialized()
    {
        Profile.OnPreferencesChange += StateHasChanged;
    }

    public void Dispose()
    {
        Profile.OnPreferencesChange -= StateHasChanged;
    }

    void Submit() => MudDialog!.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog!.Cancel();
}
