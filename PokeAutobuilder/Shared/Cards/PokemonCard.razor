@inject IDialogService DialogService
@inject PokeApiService PokeApiService
@inject ProfileService Profile

@implements IDisposable

@using PokeApiNet
@using PokeAutobuilder.Source.Services;
@using PokemonDataModel;
@using Utility

@using Type = PokeApiNet.Type

@if (Pokemon is not null && _generation is not null)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="1">
        <MudTooltip Text="@Pokemon.Name">
            <FallbackImage Urls="ArtworkCandidates" Alt="@Pokemon.Name"
                           Style="@($"max-width:100%;height:auto;-webkit-filter: drop-shadow(5px 5px 5px #222); filter: drop-shadow(5px 5px 5px #222);{(PokemonArtwork.IsPixelArt(Profile.LargeArtworkStyle) ? " image-rendering: pixelated;" : "")}")" />
        </MudTooltip>
        <MudStack Row="true" Class="pa-2">
            @foreach (PokemonType t in Pokemon.GetTypesForGeneration(_activeRuleset.Generation).Where(t => _activeRuleset.EnabledTypes.Contains(t.Type.Name)))
            {
                <MudTooltip Text="@StringUtils.PrettifyString(t.Type.Name)">
                    <MudImage Src="@StringUtils.TypeImgFromName(t.Type.Name)" alt="@t.Type.Name" Width="50" />
                </MudTooltip>
            }
        </MudStack>
        @if (IsNameDisplayed)
        {
            <MudText Typo="Typo.button" Align="Align.Center">@Pokemon.Name</MudText>
        }
        <MudText Typo="Typo.caption">@_generation.Names.Where(name => name.Language.Name == Globals.Language).FirstOrDefault()?.Name</MudText>
    </MudStack>
}
else
{
    <MudSkeleton Height="100%" Width="100%" SkeletonType="SkeletonType.Rectangle" />
}

@code {
    [Parameter, EditorRequired]
    public SmartPokemon? Pokemon { get; set; }

    [Parameter]
    public bool IsNameDisplayed { get; set; } = true;

    // The fallback-chain layer to start rendering from, shared across every card in a group (a box,
    // a team roster) so the group renders at one consistent art era - see PokemonArtwork and
    // whichever parent computes this (e.g. PokemonStorageBox, PokemonTeamCard). Left null for a
    // standalone card (a details dialog, a search preview) with no siblings to stay consistent
    // with, in which case this Pokemon resolves its own best level alone.
    [Parameter]
    public int? ArtworkLevel { get; set; }

    [CascadingParameter]
    public BoxRules? ActiveRuleset { get; set; }

    // Resolves this Pokemon's actual historical types for the ruleset's generation (e.g. Clefable
    // as pure Normal under a Gen 3 ruleset, not modern Fairy with the badge hidden), then still
    // filters by EnabledTypes as a defensive no-op - a correctly resolved historical type should
    // never be one the same ruleset disables, since DisabledTypes is derived from the same
    // generation, but this keeps a resolution bug from ever displaying an impossible type badge.
    private BoxRules _activeRuleset => ActiveRuleset ?? BoxRules.Unrestricted();

    private Generation? _generation;

    // Computed live (not cached) so it's always correct whenever this component renders for any
    // reason - including a global artwork-preference change, which isn't a parameter change and so
    // wouldn't otherwise be caught by a value cached in OnParametersSet.
    private IReadOnlyList<string> ArtworkCandidates
    {
        get
        {
            if (Pokemon is null)
                return [];

            int level = ArtworkLevel
                ?? PokemonArtwork.ResolveGroupLevel([Pokemon], _activeRuleset.Generation, Profile.LargeArtworkStyle);
            return PokemonArtwork.GetCandidates(Pokemon, _activeRuleset.Generation, Profile.LargeArtworkStyle, level);
        }
    }

    protected override void OnInitialized()
    {
        // a global artwork-preference change isn't a parameter change, so nothing else would
        // trigger this card to re-render and pick up the new style - MainLayout raises this same
        // event for the same reason (dark mode), but its own re-render doesn't cascade this deep.
        Profile.OnPreferencesChange += StateHasChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        _generation = null;
        if (Pokemon is not null)
        {
            _generation = await Pokemon.GetGenerationAsync(PokeApiService);
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Profile.OnPreferencesChange -= StateHasChanged;
    }
}
