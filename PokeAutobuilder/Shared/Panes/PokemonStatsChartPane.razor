@using PokemonDataModel
@using Utility

@if (Pokemon is not null)
{
	<div class="mud-width-full mud-height-full" style="min-height: 200px;">
		<ApexCharts.ApexChart @ref="_chart" TItem="StatItem" Title="@($"Base Stats\tTotal: {(int)_stats.Sum(stat => stat.Value)}")" Options="_options">
			<ApexCharts.ApexPointSeries TItem="StatItem"
                    Items="_stats"
                    Name="Base Stat"
                    XValue="@(e => e.Name)"
					YValue="@(e => (int)Math.Round(e.Value))"
					SeriesType="ApexCharts.SeriesType.Bar"					
                    Color="#005ba3"
                    PointColor="e=> GetStatColour(e)" />
		</ApexCharts.ApexChart>
	</div>
}

@code {
    [Parameter]
    public SmartPokemon? Pokemon { get; set; }

    private SmartPokemon? _prevPokemon;

    private class StatItem
    {
        public string Name = string.Empty;
        public double Value;
    }

    private List<StatItem> _stats = [];

    private ApexCharts.ApexChart<StatItem>? _chart;

    private ApexCharts.ApexChartOptions<StatItem> _options = new()
	{
		Title = new ApexCharts.Title()
		{
			Style = new ApexCharts.TitleStyle()
			{
				FontFamily = "var(--mud-typography-subtitle1-family)",
				FontWeight = "normal",
				FontSize = "1rem",
			},

			Align = ApexCharts.Align.Center,
			OffsetY = 25,
		},

		Chart = new ApexCharts.Chart()
		{
			Toolbar = new ApexCharts.Toolbar
			{
				Show = false
			},
			Background = "transparent",
			FontFamily = "var(--mud-typography-subtitle1-family);",
			Width = "100%",
			Height = "100%",
		},

		PlotOptions = new ApexCharts.PlotOptions()
		{
			Bar = new ApexCharts.PlotOptionsBar
			{
				Horizontal = true,
			}
		}
	};

    public string[] Labels = { "HP", "Attack", "Sp. Att", "Defense", "Sp. Def", "Speed" };

    protected override async Task OnParametersSetAsync()
    {
        if (Pokemon is not null
            && _prevPokemon != Pokemon)
        {
            _stats.Clear();
            double[] statsArray = Pokemon.GetBaseStatsArray();
            for (var i = 0; i < statsArray.Length; i++)
            {
                _stats.Add(new() { Name = Labels[i], Value = statsArray[i] });
            }

            if (_prevPokemon is not null)
            {
                await _chart!.RenderAsync();
            }

            _prevPokemon = Pokemon;
        }
    }

    private string GetStatColour(StatItem stat)
    {
        double value = Math.Max(0, Math.Min(255, stat.Value));
        double h, s, l;

        if (value <= 25)
        {
            // Dark Red → Red
            double t = EaseInOut(value / 25.0);
            h = 0;
            s = 0.9;
            l = Lerp(0.25, 0.50, t); // 25% → 50%
        }
        else if (value <= 50)
        {
            // Red → Orange
            double t = EaseInOut((value - 25) / 25.0);
            h = Lerp(0.0, 30.0, t);
            s = 0.9;
            l = 0.50;
        }
        else if (value <= 100)
        {
            // Orange → Green
            double t = EaseInOut((value - 50) / 50.0);
            h = Lerp(30.0, 100.0, t);
            s = 0.9;
            l = 0.5;
        }
        else if (value <= 150)
        {
            // Green → Teal
            double t = EaseInOut((value - 100) / 50.0);
            h = Lerp(100.0, 180.0, t);
            s = 0.9;
            l = Lerp(0.5, 0.6, t);
        }
        else
        {
            // Teal → Purple
            double t = EaseInOut((value - 150) / 105.0);
            h = Lerp(180.0, 280.0, t);
            s = 0.9;
            l = Lerp(0.60, 0.70, t);
        }

        return HslToHex(h, s, l);
    }

    private double EaseInOut(double t)
    {
        return t * t * (3 - 2 * t);
    }

    private double Lerp(double a, double b, double t)
    {
        return a + (b - a) * t;
    }

    private string HslToHex(double h, double s, double l)
    {
        h = h % 360;
        double c = (1 - Math.Abs(2 * l - 1)) * s;
        double x = c * (1 - Math.Abs((h / 60) % 2 - 1));
        double m = l - c / 2;

        double r1 = 0, g1 = 0, b1 = 0;

        if (h < 60)
        {
            r1 = c; g1 = x; b1 = 0;
        }
        else if (h < 120)
        {
            r1 = x; g1 = c; b1 = 0;
        }
        else if (h < 180)
        {
            r1 = 0; g1 = c; b1 = x;
        }
        else if (h < 240)
        {
            r1 = 0; g1 = x; b1 = c;
        }
        else if (h < 300)
        {
            r1 = x; g1 = 0; b1 = c;
        }
        else
        {
            r1 = c; g1 = 0; b1 = x;
        }

        int r = (int)((r1 + m) * 255);
        int g = (int)((g1 + m) * 255);
        int b = (int)((b1 + m) * 255);

        return $"#{r:X2}{g:X2}{b:X2}";
    }
}
