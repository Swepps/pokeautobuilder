@inherits LayoutComponentBase

@using PokeApiNet
@using PokeAutobuilder.Source.Services;
@using PokemonDataModel

@inject ProfileService ProfileService
@inject SessionService SessionService
@inject PokeApiService PokeApiService
@inject IDialogService DialogService
@inject IAnalytics GlobalTracking
@inject IJSRuntime JS
@inject ApexCharts.IApexChartService ApexChartService;


<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="@ProfileService.IsDarkMode" Theme="AutobuilderTheme" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true"
                   MaxWidth="MaxWidth.ExtraExtraLarge" />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudImage Src="icon-single.svg" Width="40" Height="40" />
            <MudStack AlignItems="AlignItems.Center" Spacing="0">
                <MudText Typo="Typo.h6">Poké Autobuilder</MudText>
            </MudStack>
        </MudStack>
        <MudSpacer />
        <MudButton EndIcon="@Icons.Custom.Brands.Discord" Color="Color.Inherit" IconSize="Size.Large"
                   Variant="Variant.Text" Target="_blank" Href="https://discord.gg/8xUTHP3UEK" Style="text-transform:none"
                   Size="Size.Small" Class="px-1 mx-1"
        >
            Join the Discord!
        </MudButton>
        <MudTooltip Text="GitHub Repository">
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://github.com/Swepps/pokemonautoteambuilder" Target="_blank" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="1" ClipMode="DrawerClipMode.Always">
        <NavMenu />
        <MudDivider />
        <MudButton OnClick="OpenPreferencesDialogAsync"
                   StartIcon="@Icons.Material.Outlined.Settings" Color="Color.Inherit" IconSize="Size.Large"
                   Variant="Variant.Text" Target="_blank" Style="text-transform:none"
                   Size="Size.Medium" Class="px-1 mx-1">
            Settings
        </MudButton>
    </MudDrawer>
    <MudMainContent Class="pt-16 mud-height-full">
        <MudContainer Class="mt-6" MaxWidth="MaxWidth.ExtraLarge">
            @if (_state == Init.Done)
            {
                <CascadingValue Value="SearchLocations">
                    @Body
                </CascadingValue>
            }
            else if (_state == Init.Initialising)
            {
                <MudProgressCircular Color="Color.Default" Indeterminate="true" Class="mt-8 mb-8" Size="Size.Large" />
                <MudText Typo="Typo.body1">Fetching data from PokeApi...</MudText>
            }
            else
            {
                <MudText Typo="Typo.body1" Color="Color.Error">Error initialising app. Please report on GitHub.</MudText>
            }
        </MudContainer>
    </MudMainContent>
    <ConsentCookie />
</MudLayout>

@code{
    public MudThemeProvider? _themeProvider;

    enum Init { Initialising, Done, Error }

    Init _state = Init.Initialising;

    public List<ILazyPokemonList> SearchLocations { get; } = new();

    MudTheme AutobuilderTheme = new MudTheme()
        {
            PaletteLight = new PaletteLight()
            {
                Primary = Colors.Red.Accent3,
                Secondary = Colors.Blue.Accent3,
                Dark = Colors.Gray.Lighten1,

                Background = Colors.Gray.Lighten3,
                BackgroundGray = Colors.Gray.Lighten2,
                DrawerBackground = "#d3d3d3",
                AppbarBackground = Colors.Gray.Lighten1,
                Surface = "#e3e3e3",

                DrawerText = Colors.Gray.Darken3,
                TextPrimary = Colors.Gray.Darken4,
                AppbarText = Colors.Gray.Darken4,
            },
            PaletteDark = new PaletteDark()
            {
                Primary = Colors.Red.Accent2,
                Secondary = Colors.Blue.Accent2,
                Dark = Colors.Gray.Darken2,

                Background = Colors.Gray.Darken4,
                BackgroundGray = Colors.Gray.Darken4,
                DrawerBackground = "#383838",
                AppbarBackground = Colors.Gray.Darken3,
                Surface = "#252525",

                DrawerText = Colors.Gray.Lighten4,
                TextPrimary = Colors.Gray.Lighten4,
                AppbarText = Colors.Gray.Lighten4,
            },

            LayoutProperties = new LayoutProperties()
            {
                DrawerWidthLeft = "260px",
            }
        };

    public async Task OpenPreferencesDialogAsync()
    {
        var parameters = new DialogParameters<PreferencesDialog>();
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            BackgroundClass = "dimmed-background",
            FullWidth = false,
            MaxWidth = MaxWidth.Small,
        };
        await DialogService.ShowAsync<PreferencesDialog>("Settings", parameters, options);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // disable Google analytics if user has declined it
            bool hasCookiePolicy = await JS.InvokeAsync<bool>("HasCookiePolicy");
            if (hasCookiePolicy)
            {
                bool cookiePolicyAccepted = await JS.InvokeAsync<bool>("GetCookiePolicyAccepted");
                if (!cookiePolicyAccepted)
                {
                    GlobalTracking.Disable();
                }
            }

            // initialising global variables used across the app
            // load preferences first before the slow ones
            Preferences prefs = await ProfileService.GetPreferencesAsync();

            StateHasChanged();

            ProfileService.OnPreferencesChange += StateHasChanged;

            await ProfileService.LoadProfileStorage();  
            await SessionService.LoadSessionStorage();

            if (ProfileService.AllTypes?.Count > 0)
            {
                _state = Init.Done;
            }
            else
            {
                // uh oh
                _state = Init.Error;

            }

            SearchLocations.AddRange(ProfileService.PokemonStorage.Boxes);
            SearchLocations.Add(new SmartPokedex(PokeApiService, "National Pokédex", new NamedApiResource<Pokedex> { Name = "national", Url = "https://pokeapi.co/api/v2/pokedex/1/" }));
            foreach (PokemonVersionGroup versionGroup in PokemonVersionGroup.All)
            {
                SearchLocations.Add(new SmartPokedex(PokeApiService, versionGroup.DisplayName, new NamedApiResource<VersionGroup> { Name = versionGroup.ApiName, Url = versionGroup.ApiUrl }));
            }

            StateHasChanged();
        }
    }

    // nav menu
    bool _open = true;

    void ToggleDrawer()
    {
        _open = !_open;
    }
}
