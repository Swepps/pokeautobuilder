@page "/storage"

@using PokeApiNet
@using PokemonDataModel
@using PokeAutobuilder.Source.Services
@using PokeAutobuilder.Shared;

@inject NavigationManager NavigationManager
@inject ProfileService Profile
@inject SessionService Session
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject PokeApiService PokeApiService

@implements IDisposable

<PageTitle>Pokémon Storage</PageTitle>

<InputFile id="filePicker" @ref="_filePicker" accept=".json" OnChange="HandleFileSelectedAsync" style="display: none;"/>

<div class="d-flex flex-wrap">
    <MudPaper MaxWidth="650px" Height="fit-content">
        @switch (_storagePanel)
        {
            case StoragePanel.Add: 
                <MudStack Class="pa-2" Style="max-width: 250px;">
                    <MudSelect T="ILazyPokemonList" Label="Search Location" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" FullWidth="false"
                    ToStringFunc="@(l => l?.Name ?? string.Empty)"
                    @bind-Value="_searchLocation">
                        @foreach (ILazyPokemonList list in SearchLocations!)
                        {
                            @if (IsSearchLocationCompatible(list))
                            {
                                <MudSelectItem T="ILazyPokemonList" Value="list">
                                    @list.Name
                                </MudSelectItem>
                            }
                        }
                    </MudSelect>
                    <div style="max-width: 250px;">
                        <PokemonSearchBox @ref="_pokemonSearchBox" SearchFunc="SearchAsync" ActiveRuleset="SelectedBox.Rules">
                            <ExtraButtons>

                                @if (_pokemonSearchBox!.Pokemon is not null)
                                {
                                    <MudTooltip Text="Add To Storage">
                                        <MudIconButton Disabled="@(SelectedBox.Pokemon.Contains(_pokemonSearchBox!.Pokemon!))"
                                        Size="Size.Small" Icon="@Icons.Material.Filled.Save" OnClick="OnClickAddToStorageAsync"></MudIconButton>
                                    </MudTooltip>
                                }

                                <MudTooltip Text="Randomize">
                                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Loop" OnClick="OnClickRandomizeAsync"></MudIconButton>
                                </MudTooltip>

                            </ExtraButtons>
                        </PokemonSearchBox>
                    </div>
                </MudStack>
                break;

            case StoragePanel.Edit:
                <CascadingValue Value="SelectedBox.Rules">
                    <PokemonDetails Pokemon="SelectedPokemon" OnMoveChanged="OnPokemonMoveChanged">
                        <ActionsContent>
                            <div class="d-flex justify-center align-end mud-height-full">
                                <MudButtonGroup Vertical="true"
                                OverrideStyles="false"
                                Size="Size.Large"
                                Class="mud-width-full"
                                >
                                    <MudButton Variant="Variant.Outlined"
                                    Disabled="true">
                                        MOVE
                                    </MudButton>
                                    <MudButton
                                    Variant="Variant.Outlined"
                                    OnClick="OnClickEvolveAsync"
                                    Disabled="@(!_selectedPokemonCanEvolve)">
                                        EVOLVE
                                    </MudButton>
                                    <MudButton Color="Color.Error"
                                    Variant="Variant.Outlined"
                                    OnClick="OnClickReleaseAsync"
                                    Disabled="@(SelectedPokemon is null)">
                                        RELEASE
                                    </MudButton>
                                </MudButtonGroup>
                            </div>
                        </ActionsContent>
                    </PokemonDetails>
                </CascadingValue>
                break;

            default:
                break;
        }
    </MudPaper>

    <div class="ma-1 d-flex flex-1" style="min-width: 500px;">
        <MudStack Spacing="0" AlignItems="AlignItems.Center">
            <MudPaper Outlined="true" Width="fit-content">
                <MudToolBar WrapContent="true">
                    <MudToggleGroup T="StoragePanel" @bind-Value="_storagePanel" Class="my-4">
                        <MudTooltip Text="Open the Pokémon browser">
                            <MudToggleItem Value="StoragePanel.Add">
                                <MudIcon Icon="@Icons.Material.Outlined.Search" />
                            </MudToggleItem>
                        </MudTooltip>
                        <MudTooltip Text="Edit the currently selected Pokémon">
                            <MudToggleItem Value="StoragePanel.Edit" Disabled="@(_selectedPokemon == null)">
                                <MudIcon Icon="@Icons.Material.Outlined.Edit" />
                            </MudToggleItem>
                        </MudTooltip>
                    </MudToggleGroup>

                    <MudDivider Vertical="true" DividerType="DividerType.FullWidth" />

                    <MudButtonGroup Variant="Variant.Outlined" Class="ml-2 my-4 mr-4" Color="Color.Primary">
                        <MudTooltip Text="Add a new Pokémon box">
                            <MudIconButton OnClick="@OnClickAddBox" Icon="@Icons.Material.Filled.Add" />
                        </MudTooltip>
                        <MudTooltip Text="Delete this Pokémon box">
                            <MudIconButton OnClick="@OnClickDeleteBoxAsync" Icon="@Icons.Material.Filled.Delete" Disabled="@(Profile.PokemonStorage.Boxes.Count <= 1)" />
                        </MudTooltip>
                        <MudTooltip Text="Download this Pokémon box">
                            <MudIconButton OnClick="@OnClickDownloadBoxAsync" Icon="@Icons.Material.Filled.Download" />
                        </MudTooltip>
                        <MudTooltip Text="Upload a Pokémon box">
                            <MudIconButton OnClick="@OnClickUploadBoxAsync" Icon="@Icons.Material.Filled.Upload" />
                        </MudTooltip>
                    </MudButtonGroup>

                    <MudStack Row="true" class="flex-grow-1 my-1">
                        <MudTextField @bind-Value="_boxName"
                                      Label="Box Name"
                                      Variant="Variant.Outlined"
                                      FullWidth="false"
                                      Margin="Margin.Dense"/>

                        <MudSelect T="int?" Label="Ruleset" @bind-Value="_selectedBoxGeneration"
                                   AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                                   Variant="Variant.Outlined" FullWidth="false" Margin="Margin.Dense">
                            <MudSelectItem T="int?" Value="null">Unrestricted</MudSelectItem>
                            @foreach (int gen in _generationOptions)
                            {
                                <MudSelectItem T="int?" Value="gen">Generation @gen</MudSelectItem>
                            }
                        </MudSelect>

                        <MudPagination Count="@Profile.PokemonStorage.Boxes.Count" @bind-Selected="SelectedBoxNumber" BoundaryCount="2" />
                    </MudStack>
                </MudToolBar>
            </MudPaper>
            <CascadingValue Value="@(_selectedPokemonList)">
                <PokemonStorageBox PokemonCollection="SelectedBox!.Pokemon" OnClickPokemon="OnSelectPokemonAsync" />
            </CascadingValue>
        </MudStack>
    </div>

</div>

<PageFooter />

@code {
    [CascadingParameter]
    public List<ILazyPokemonList>? SearchLocations { get; set; }

    private ILazyPokemonList? _searchLocationField;
    private ILazyPokemonList? _searchLocation
    {
        get => _searchLocationField;
        set
        {
            _searchLocationField = value;
            if (value is not null)
            {
                SelectedBox.LastSearchLocationName = value.Name;
                _ = Profile.UpdatePokemonStorageAsync();
            }
        }
    }

    // A box's ruleset generation (if any) constrains which Pokedex search locations make sense for
    // it - e.g. a Gen 3 box should only offer Ruby/Sapphire, Emerald, FireRed/LeafGreen and
    // Colosseum, not the National Dex or other generations' games. Boxes themselves are never
    // shown here regardless of ruleset (existing behavior - the Add panel searches games, not
    // other boxes). Unrestricted (Generation is null) keeps today's "everything" behavior.
    private bool IsSearchLocationCompatible(ILazyPokemonList location)
    {
        if (Profile.PokemonStorage.Boxes.Contains(location))
            return false;

        int? generation = SelectedBox.Rules.Generation;
        if (generation is null)
            return true;

        return location is SmartPokedex dex
            && dex.SourceVersionGroup is not null
            && dex.SourceVersionGroup.Generation == generation;
    }

    // Restores this box's remembered search location (e.g. it was last browsing Emerald), falling
    // back to the first ruleset-compatible option if there's no remembered location or it's no
    // longer valid (the box's ruleset changed, or the remembered location doesn't exist this
    // session). Assigns the backing field directly rather than through the _searchLocation
    // property setter, since merely resolving/restoring isn't a user action worth re-persisting.
    private void ResolveSearchLocationForSelectedBox()
    {
        IEnumerable<ILazyPokemonList> compatible = (SearchLocations ?? []).Where(IsSearchLocationCompatible);
        _searchLocationField =
            compatible.FirstOrDefault(l => l.Name == SelectedBox.LastSearchLocationName)
            ?? compatible.FirstOrDefault();
    }

    private PokemonSearchBox? _pokemonSearchBox;

    private List<SmartPokemon> _selectedPokemonList = [];
    private SmartPokemon? _selectedPokemon;
    public SmartPokemon? SelectedPokemon 
    {
        get => _selectedPokemon;
        set
        {
            _selectedPokemon = value;
            _selectedPokemonList.Clear();
            if (value is not null) _selectedPokemonList.Add(value);
        }
    }

    private bool _selectedPokemonCanEvolve = false;

    private int _selectedBoxNumber = 1;
    public int SelectedBoxNumber
    {
        get => _selectedBoxNumber;
        set
        {
            _selectedBoxNumber = value;
            SelectedBox = Profile.PokemonStorage.Boxes[_selectedBoxNumber - 1];
        }
    }

    private PokemonBox _selectedBox = new();
    public PokemonBox SelectedBox
    {
        get => _selectedBox;
        set
        {
            _selectedBox = value;
            ResolveSearchLocationForSelectedBox();
        }
    }

    private string _boxName
    {
        get => SelectedBox.Name;
        set
        {
            SelectedBox.Name = value;
            _ = Profile.UpdatePokemonStorageAsync();
        }
    }

    // materialized rather than looped with a bare `for` in the markup - a `for` loop's variable is
    // a single mutable slot shared by every iteration's render fragment, so every MudSelectItem
    // would end up showing whatever value the loop variable held when the fragments actually
    // render (here, 10, one past the last iteration) rather than its own generation number
    private static readonly int[] _generationOptions = [1, 2, 3, 4, 5, 6, 7, 8, 9];

    // null = Unrestricted, otherwise the generation preset
    private int? _selectedBoxGeneration
    {
        get => SelectedBox.Rules.Generation;
        set
        {
            BoxRules currentRules = SelectedBox.Rules;
            BoxRules newRules = value is int gen
                ? BoxRules.ForGeneration(gen, currentRules.AllowMultipleMegas, currentRules.AllowMultipleGmax)
                : BoxRules.Unrestricted(currentRules.AllowMultipleMegas, currentRules.AllowMultipleGmax);
            _ = Profile.UpdateBoxRulesAsync(SelectedBox, newRules);
            ResolveSearchLocationForSelectedBox();
        }
    }

    protected enum StoragePanel { Edit, Add }
    protected StoragePanel _storagePanel = StoragePanel.Add;

    private InputFile? _filePicker;

    private string _messageBoxState = "Message box hasn't been opened yet";

    protected override void OnInitialized()
    {
        // register interest in session changing to update this page
        Profile.OnStorageChange += StateHasChanged;

        if (Profile.PokemonStorage.Boxes.Count > 0)
        {
            SelectedBox = Profile.PokemonStorage.Boxes[0];
        }
        else
        {
            Profile.PokemonStorage.Boxes.Add(SelectedBox);
            _ = Profile.UpdatePokemonStorageAsync();
            ResolveSearchLocationForSelectedBox();
        }
    }

    public void Dispose()
    {
        Profile.OnStorageChange -= StateHasChanged;
    }

    protected async Task OnSelectPokemonAsync(SmartPokemon selectedPokemon)
    {
        _selectedPokemonCanEvolve = await PokeApiService.CanEvolve(selectedPokemon, SelectedBox.Rules.Generation);
        SelectedPokemon = selectedPokemon;
        _storagePanel = StoragePanel.Edit;
        StateHasChanged();
    }

    protected void OnClickAddBox()
    {
        Profile.PokemonStorage.Boxes.Add(new PokemonBox($"Box {Profile.PokemonStorage.Boxes.Count + 1}") { Rules = Profile.MakeDefaultRulesForNewBox() });
        _ = Profile.UpdatePokemonStorageAsync();
        if (SearchLocations is not null)
        {
            SearchLocations.Insert(Profile.PokemonStorage.Boxes.Count - 1, Profile.PokemonStorage.Boxes.Last());
        }
        SelectedBoxNumber = Profile.PokemonStorage.Boxes.Count;
        SelectedPokemon = null;
        _storagePanel = StoragePanel.Add;
    }

    protected async Task OnClickDeleteBoxAsync()
    {
        if (SelectedBoxNumber > 0 
            && SelectedBoxNumber <= Profile.PokemonStorage.Boxes.Count)
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                "Warning"
                , $"Are you sure you want to delete box: {SelectedBox.Name}?"
                , yesText: "Delete!"
                , cancelText: "Cancel"
                , options: new() { MaxWidth = MaxWidth.ExtraSmall }
            );
            if (result is not null)
            {
                if (SearchLocations is not null)
                {
                    SearchLocations.Remove(Profile.PokemonStorage.Boxes.ElementAt(SelectedBoxNumber - 1));
                }
                Profile.PokemonStorage.Boxes.RemoveAt(SelectedBoxNumber - 1);
                _ = Profile.UpdatePokemonStorageAsync();
                SelectedBoxNumber = Math.Clamp(SelectedBoxNumber, 1, Profile.PokemonStorage.Boxes.Count);
                SelectedPokemon = null;
                _storagePanel = StoragePanel.Add;
            }
        }
    }

    protected async Task OnClickDownloadBoxAsync()
    {
        await JS.InvokeVoidAsync("localStorageHelper.exportBoxToFile", "pokemon_storage", SelectedBoxNumber - 1, $"pokeautobuilderbox-{SelectedBox.Name}.json");
    }

    protected async Task OnClickUploadBoxAsync()
    {
        if (_filePicker is null) return;

        await JS.InvokeVoidAsync("localStorageHelper.clickElement", _filePicker.Element);
    }

    private string? _pendingUploadWarning;

    [JSInvokable]
    public Task<bool> ValidateBoxJson(string json)
    {
        bool isValid = JsonValidator.TryValidatePokemonBoxJson(json, out _, out _pendingUploadWarning);
        return Task.FromResult(isValid);
    }

    [JSInvokable]
    public async Task OnUploadBoxSuccessAsync()
    {
        await Profile.LoadPokemonStorageAsync();
        // select the last box in the list as it will be the one that was just imported
        SelectedBoxNumber = Profile.PokemonStorage.Boxes.Count;
        SelectedPokemon = null;
        _storagePanel = StoragePanel.Add;

        if (_pendingUploadWarning is not null)
        {
            Snackbar.Add(_pendingUploadWarning, Severity.Warning);
            _pendingUploadWarning = null;
        }

        StateHasChanged();
    }

    [JSInvokable]
    public Task OnUploadBoxFailure(string errorString)
    {
        Snackbar.Add($"Failed to upload box. Error: \n{errorString}", Severity.Error);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleFileSelectedAsync(InputFileChangeEventArgs e)
    {
        await JS.InvokeVoidAsync("localStorageHelper.importBoxFromFile", "pokemon_storage", "filePicker", DotNetObjectReference.Create(this));
    }

    protected async Task OnClickReleaseAsync()
    {
        if (SelectedPokemon is not null)
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                "Warning"
                , "Are you sure you want to release " + SelectedPokemon.ToString() + "?"
                , yesText: "Release!"
                , cancelText: "Cancel"
                , options: new() { MaxWidth = MaxWidth.ExtraSmall }
            );
            _messageBoxState = result == null ? "Canceled" : "Released";
            if (_messageBoxState == "Released")
            {
                await Profile.RemovePokemonFromStorageAsync(SelectedPokemon);
                SmartPokemon? newSelectedPokemon = SelectedBox.Pokemon.FirstOrDefault();
                if (newSelectedPokemon is not null)
                {
                    await OnSelectPokemonAsync(newSelectedPokemon);
                }
            }
        }
    }

    protected async Task OnClickEvolveAsync()
    {
        var parameters = new DialogParameters();
        parameters.Add("Pokemon", SelectedPokemon);
        parameters.Add("ActiveRuleset", SelectedBox.Rules);

        var dialog = await DialogService.ShowAsync<EvolvePokemonDialog>("Evolving " + SelectedPokemon!.ToString() + "..."
        , parameters
        , options: new() { MaxWidth = MaxWidth.Medium });
        var result = await dialog.Result;

        if (result is not null
            && !result.Canceled && result.Data is SmartPokemon)
        {
            // replace old pokemon with evolved version
            SmartPokemon? pokemon = result.Data as SmartPokemon;
            if (pokemon is not null)
            {
                await Profile.ReplacePokemonInStorageAsync(SelectedPokemon, pokemon);

                await OnSelectPokemonAsync(pokemon);
            }
        }
    }

    protected async Task OnClickAddToStorageAsync()
    {
        await Profile.AddPokemonToStorageAsync(_pokemonSearchBox!.Pokemon!, SelectedBoxNumber - 1);
    }

    protected async Task OnClickRandomizeAsync()
    {
        _pokemonSearchBox!.PokemonSearchValue = null;
        IEnumerable<IPokemonSearchable> list = await _searchLocation!.GetListAsync();
        Random rand = new Random();
        int index = rand.Next(0, list.Count());
        _pokemonSearchBox.PokemonSearchValue = list.ElementAt(index);
    }

    protected void OnPokemonMoveChanged((SmartPokemon, int, PokemonMove?) args)
    {
        // update in the background
        _ = Profile.UpdatePokemonStorageAsync();
    }

    protected Task<IEnumerable<IPokemonSearchable>> SearchAsync(string? searchString, CancellationToken token)
    {
        return _searchLocation.SearchAsync(searchString);
    }
}
