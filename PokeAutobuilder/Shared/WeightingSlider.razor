<MudTooltip Text="@Tooltip" Placement="Placement.Bottom" RootClass="mud-width-full">
    <MudGrid>

        @if (InlineLabel)
        {
            <MudItem xs="3">
                <div class="d-flex justify-end">
                    <MudText Typo="Typo.caption">
                        @($"{Name}:")
                    </MudText>
                </div>
            </MudItem>

            <MudItem xs="9">
                <MudSlider @bind-Value="Value" Size="@Size" Min="0" Max="1" Step="0.05" Variant="Variant.Filled" Disabled="Disabled" />
            </MudItem>
        }
        else
        {
            <MudItem xs="12">
                <MudSlider @bind-Value="Value" Size="@Size" Min="0" Max="1" Step="0.05" Variant="Variant.Filled" Disabled="Disabled" >
                    <MudText Typo="Typo.caption">
                        @Name
                    </MudText>
                </MudSlider>
            </MudItem>
        }

        @if (Score is not null)
        {
            <MudItem xs="12">
                <MudProgressLinear Color="Color.Tertiary" Size="@Size" Value="@((double)Score)" Max="1.0">
                    <MudText Typo="Typo.caption">@(String.Format("{0:0.00}", Score * 100))%</MudText>
                </MudProgressLinear>
            </MudItem>
        }
    </MudGrid>
</MudTooltip>

@code {
    protected double _value;

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Tooltip { get; set; }

    #pragma warning disable BL0007
    [Parameter]
    public double Value
    {
        get => _value;
        set
        {
            if (_value != value)
            {
                _value = value;
                ValueChanged.InvokeAsync((double)value);
            }
        }
    }
    #pragma warning restore BL0007

    [Parameter]
    public double? Score { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool InlineLabel { get; set; } = false;

    [Parameter]
    public Size Size { get; set; } = Size.Small;

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }
}
